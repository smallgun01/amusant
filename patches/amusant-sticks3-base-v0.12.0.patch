@@ -0,0 +1,42 @@
+#pragma once
+
+#include <stdint.h>
+
+#include "wifi_config.h"
+
+namespace wifi_console {
+
+enum class EventType : uint8_t { None, Status, Clear, SetReady, Set, Error, Timeout };
+
+struct Event {
+  EventType type;
+  wifi_config::Profile profile;
+};
+
+class Parser {
+ public:
+  Parser();
+  bool feed(uint8_t byte, uint32_t nowMs, Event& event);
+  bool poll(uint32_t nowMs, Event& event);
+
+ private:
+  enum class State : uint8_t { Line, Payload };
+  void reset();
+  bool consumeByte(uint8_t byte, uint32_t nowMs, Event& event);
+  bool processLine(uint32_t nowMs, Event& event);
+
+  State state_;
+  char line_[40];
+  uint8_t lineLength_;
+  bool discardLine_;
+  uint8_t payload_[95];
+  uint8_t payloadLength_;
+  uint8_t payloadRead_;
+  uint8_t expectedSsidLength_;
+  uint8_t expectedPasswordLength_;
+  uint32_t lastByteAtMs_;
+};
+
+const char* statusResponse(bool configured, bool invalid, bool connected);
+
+}  // namespace wifi_console
diff --git a/firmware/src/wifi_provisioning_commit_gate.h b/firmware/src/wifi_provisioning_commit_gate.h
new file mode 100644
index 0000000..1753827
--- /dev/null
+++ b/firmware/src/wifi_provisioning_commit_gate.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace wifi_provisioning_commit_gate {
+
+constexpr uint32_t kAssociationTimeoutMs = 15000;
+
+enum class PollResult : uint8_t {
+  None,
+  Waiting,
+  Commit,
+  TimedOut,
+};
+
+class Gate {
+ public:
+  Gate() : pending_(false), providerEnded_(false), startedAtMs_(0) {}
+
+  void reset() {
+    pending_ = false;
+    providerEnded_ = false;
+    startedAtMs_ = 0;
+  }
+
+  bool acceptCredentialsSucceeded(uint32_t nowMs) {
+    if (pending_) return false;
+    pending_ = true;
+    providerEnded_ = false;
+    startedAtMs_ = nowMs;
+    return true;
+  }
+
+  bool onProviderDeinitialized() {
+    providerEnded_ = true;
+    return pending_;
+  }
+
+  PollResult poll(uint32_t nowMs, bool wifiConnected, bool hasIpAddress) {
+    if (!pending_) return PollResult::None;
+    if (wifiConnected && hasIpAddress) {
+      pending_ = false;
+      return PollResult::Commit;
+    }
+    if (uint32_t(nowMs - startedAtMs_) >= kAssociationTimeoutMs) {
+      pending_ = false;
+      return PollResult::TimedOut;
+    }
+    return PollResult::Waiting;
+  }
+
+  void cancel() {
+    pending_ = false;
+    startedAtMs_ = 0;
+  }
+
+  bool pending() const { return pending_; }
+  bool providerEnded() const { return providerEnded_; }
+
+ private:
+  bool pending_;
+  bool providerEnded_;
+  uint32_t startedAtMs_;
+};
+
+}  // namespace wifi_provisioning_commit_gate
diff --git a/firmware/src/wifi_provisioning_event_queue.h b/firmware/src/wifi_provisioning_event_queue.h
new file mode 100644
index 0000000..d83d794
--- /dev/null
+++ b/firmware/src/wifi_provisioning_event_queue.h
@@ -0,0 +1,224 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "wifi_config.h"
+#include "wifi_provisioning_lifecycle.h"
+
+namespace wifi_provisioning_event_queue {
+
+constexpr size_t kCredentialQueueCapacity = 4;
+constexpr size_t kProviderEventCount = 5;
+
+struct Event {
+  wifi_provisioning_lifecycle::ProviderEvent type;
+  wifi_config::Profile profile;
+  uint32_t callbackAtMs;
+  uint32_t sequence;
+};
+
+struct Snapshot {
+  uint32_t callbacks[kProviderEventCount];
+  uint32_t dequeued[kProviderEventCount];
+  uint32_t dropped[kProviderEventCount];
+  uint32_t lastCallbackAtMs[kProviderEventCount];
+  uint32_t lastDequeuedAtMs[kProviderEventCount];
+  uint32_t lastDequeuedCallbackAtMs[kProviderEventCount];
+  uint32_t overflowCount;
+  uint8_t credentialDepth;
+  bool serviceEndedPending;
+  bool deinitializedPending;
+};
+
+enum class ServiceResult : uint8_t { Empty, Overflow, Event };
+
+struct ServiceStep {
+  ServiceResult result;
+  bool requestStop;
+};
+
+class Queue {
+ public:
+  Queue() { reset(); }
+
+  void reset() {
+    clearPending();
+    for (size_t i = 0; i < kProviderEventCount; ++i) {
+      callbacks_[i] = 0;
+      dequeued_[i] = 0;
+      dropped_[i] = 0;
+      lastCallbackAtMs_[i] = 0;
+      lastDequeuedAtMs_[i] = 0;
+      lastDequeuedCallbackAtMs_[i] = 0;
+    }
+    overflowCount_ = 0;
+    overflowHandled_ = 0;
+    nextSequence_ = 1;
+  }
+
+  bool enqueue(wifi_provisioning_lifecycle::ProviderEvent type,
+               const wifi_config::Profile* profile, uint32_t callbackAtMs) {
+    const size_t index = eventIndex(type);
+    ++callbacks_[index];
+    lastCallbackAtMs_[index] = callbackAtMs;
+
+    if (type == wifi_provisioning_lifecycle::ProviderEvent::ServiceEnded) {
+      if (!serviceEndedPending_) {
+        serviceEndedSequence_ = nextSequence_++;
+        serviceEndedAtMs_ = callbackAtMs;
+      }
+      serviceEndedPending_ = true;
+      return true;
+    }
+    if (type == wifi_provisioning_lifecycle::ProviderEvent::Deinitialized) {
+      if (!deinitializedPending_) {
+        deinitializedSequence_ = nextSequence_++;
+        deinitializedAtMs_ = callbackAtMs;
+      }
+      deinitializedPending_ = true;
+      return true;
+    }
+
+    if (credentialCount_ >= kCredentialQueueCapacity) {
+      ++dropped_[index];
+      ++overflowCount_;
+      return false;
+    }
+
+    Event& queued = credentialEvents_[credentialTail_];
+    queued.type = type;
+    queued.callbackAtMs = callbackAtMs;
+    queued.sequence = nextSequence_++;
+    wifi_config::wipeSensitive(queued.profile);
+    if (profile != NULL) queued.profile = *profile;
+    credentialTail_ = static_cast<uint8_t>((credentialTail_ + 1) % kCredentialQueueCapacity);
+    ++credentialCount_;
+    return true;
+  }
+
+  bool takeOverflow() {
+    const bool overflowed = overflowCount_ != overflowHandled_;
+    overflowHandled_ = overflowCount_;
+    return overflowed;
+  }
+
+  bool dequeue(Event& event, uint32_t dequeuedAtMs, bool terminalOnly = false) {
+    const bool credentialAvailable = !terminalOnly && credentialCount_ > 0;
+    const bool takeServiceEnd = serviceEndedPending_ &&
+        (!deinitializedPending_ || serviceEndedSequence_ < deinitializedSequence_);
+    const bool terminalAvailable = serviceEndedPending_ || deinitializedPending_;
+    const uint32_t terminalSequence = takeServiceEnd ? serviceEndedSequence_ : deinitializedSequence_;
+
+    if (!credentialAvailable && !terminalAvailable) return false;
+    if (credentialAvailable && (!terminalAvailable ||
+        credentialEvents_[credentialHead_].sequence < terminalSequence)) {
+      event = credentialEvents_[credentialHead_];
+      wipeEvent(credentialEvents_[credentialHead_]);
+      credentialHead_ = static_cast<uint8_t>((credentialHead_ + 1) % kCredentialQueueCapacity);
+      --credentialCount_;
+      ++dequeued_[eventIndex(event.type)];
+      lastDequeuedAtMs_[eventIndex(event.type)] = dequeuedAtMs;
+      lastDequeuedCallbackAtMs_[eventIndex(event.type)] = event.callbackAtMs;
+      return true;
+    }
+    event.type = takeServiceEnd ? wifi_provisioning_lifecycle::ProviderEvent::ServiceEnded
+                                : wifi_provisioning_lifecycle::ProviderEvent::Deinitialized;
+    event.callbackAtMs = takeServiceEnd ? serviceEndedAtMs_ : deinitializedAtMs_;
+    event.sequence = terminalSequence;
+    wifi_config::wipeSensitive(event.profile);
+    if (takeServiceEnd) {
+      serviceEndedPending_ = false;
+    } else {
+      deinitializedPending_ = false;
+    }
+    ++dequeued_[eventIndex(event.type)];
+    lastDequeuedAtMs_[eventIndex(event.type)] = dequeuedAtMs;
+    lastDequeuedCallbackAtMs_[eventIndex(event.type)] = event.callbackAtMs;
+    return true;
+  }
+
+  void clearCredentialEvents() {
+    for (size_t i = 0; i < kCredentialQueueCapacity; ++i) wipeEvent(credentialEvents_[i]);
+    credentialHead_ = credentialTail_ = credentialCount_ = 0;
+    overflowHandled_ = overflowCount_;
+  }
+
+  void clearPending() {
+    clearCredentialEvents();
+    serviceEndedPending_ = false;
+    deinitializedPending_ = false;
+    serviceEndedSequence_ = 0;
+    deinitializedSequence_ = 0;
+    serviceEndedAtMs_ = 0;
+    deinitializedAtMs_ = 0;
+  }
+
+  bool hasTerminalPending() const { return serviceEndedPending_ || deinitializedPending_; }
+
+  void snapshot(Snapshot& output) const {
+    for (size_t i = 0; i < kProviderEventCount; ++i) {
+      output.callbacks[i] = callbacks_[i];
+      output.dequeued[i] = dequeued_[i];
+      output.dropped[i] = dropped_[i];
+      output.lastCallbackAtMs[i] = lastCallbackAtMs_[i];
+      output.lastDequeuedAtMs[i] = lastDequeuedAtMs_[i];
+      output.lastDequeuedCallbackAtMs[i] = lastDequeuedCallbackAtMs_[i];
+    }
+    output.overflowCount = overflowCount_;
+    output.credentialDepth = credentialCount_;
+    output.serviceEndedPending = serviceEndedPending_;
+    output.deinitializedPending = deinitializedPending_;
+  }
+
+  static size_t eventIndex(wifi_provisioning_lifecycle::ProviderEvent type) {
+    return static_cast<size_t>(type);
+  }
+
+ private:
+  static void wipeEvent(Event& event) {
+    event.type = wifi_provisioning_lifecycle::ProviderEvent::CredentialsFailed;
+    event.callbackAtMs = 0;
+    event.sequence = 0;
+    wifi_config::wipeSensitive(event.profile);
+  }
+
+  Event credentialEvents_[kCredentialQueueCapacity] = {};
+  uint8_t credentialHead_ = 0;
+  uint8_t credentialTail_ = 0;
+  uint8_t credentialCount_ = 0;
+  bool serviceEndedPending_ = false;
+  bool deinitializedPending_ = false;
+  uint32_t serviceEndedSequence_ = 0;
+  uint32_t deinitializedSequence_ = 0;
+  uint32_t serviceEndedAtMs_ = 0;
+  uint32_t deinitializedAtMs_ = 0;
+  uint32_t nextSequence_ = 1;
+  uint32_t callbacks_[kProviderEventCount] = {};
+  uint32_t dequeued_[kProviderEventCount] = {};
+  uint32_t dropped_[kProviderEventCount] = {};
+  uint32_t lastCallbackAtMs_[kProviderEventCount] = {};
+  uint32_t lastDequeuedAtMs_[kProviderEventCount] = {};
+  uint32_t lastDequeuedCallbackAtMs_[kProviderEventCount] = {};
+  uint32_t overflowCount_ = 0;
+  uint32_t overflowHandled_ = 0;
+};
+
+inline ServiceStep serviceStep(Queue& queue, Event& event,
+                               wifi_provisioning_lifecycle::ManagerLifecycle& manager,
+                               uint32_t nowMs, bool terminalOnly = false) {
+  if (queue.takeOverflow()) {
+    queue.clearCredentialEvents();
+    return {ServiceResult::Overflow, manager.requestStop()};
+  }
+  if (!queue.dequeue(event, nowMs, terminalOnly)) return {ServiceResult::Empty, false};
+
+  if (event.type == wifi_provisioning_lifecycle::ProviderEvent::ServiceEnded) {
+    manager.onServiceEnded();
+  } else if (event.type == wifi_provisioning_lifecycle::ProviderEvent::Deinitialized) {
+    manager.onDeinitialized();
+  }
+  return {ServiceResult::Event, false};
+}
+
+}  // namespace wifi_provisioning_event_queue
diff --git a/firmware/src/wifi_provisioning_lifecycle.h b/firmware/src/wifi_provisioning_lifecycle.h
new file mode 100644
index 0000000..2cff41e
--- /dev/null
+++ b/firmware/src/wifi_provisioning_lifecycle.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace wifi_provisioning_lifecycle {
+
+class ManagerLifecycle {
+ public:
+  enum class State : uint8_t {
+    Inactive,
+    Running,
+    StopRequested,
+    ServiceEnded,
+    ExplicitDeinitRequested,
+  };
+
+  ManagerLifecycle() : state_(State::Inactive) {}
+
+  bool onInitialized() {
+    if (state_ != State::Inactive) return false;
+    state_ = State::Running;
+    return true;
+  }
+
+  bool requestStop() {
+    if (state_ != State::Running) return false;
+    state_ = State::StopRequested;
+    return true;
+  }
+
+  bool requestDeinitialize() {
+    if (state_ != State::Running) return false;
+    state_ = State::ExplicitDeinitRequested;
+    return true;
+  }
+
+  void onServiceEnded() {
+    if (state_ == State::Inactive || state_ == State::ServiceEnded ||
+        state_ == State::ExplicitDeinitRequested) return;
+    state_ = State::ServiceEnded;
+  }
+
+  bool onDeinitialized() {
+    if (state_ == State::Inactive) return false;
+    state_ = State::Inactive;
+    return true;
+  }
+
+  bool active() const { return state_ != State::Inactive; }
+  State state() const { return state_; }
+  bool stopRequested() const { return state_ == State::StopRequested; }
+  bool serviceEnded() const { return state_ == State::ServiceEnded; }
+  bool deinitializationRequested() const { return state_ == State::ExplicitDeinitRequested; }
+
+ private:
+  State state_;
+};
+
+enum class ProviderEvent : uint8_t {
+  CredentialsReceived,
+  CredentialsFailed,
+  CredentialsSucceeded,
+  ServiceEnded,
+  Deinitialized,
+};
+
+inline bool discardOnCancel(ProviderEvent event) {
+  return event != ProviderEvent::ServiceEnded && event != ProviderEvent::Deinitialized;
+}
+
+}  // namespace wifi_provisioning_lifecycle
