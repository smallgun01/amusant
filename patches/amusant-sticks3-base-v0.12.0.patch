+#pragma once
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+
+/*
+ * This library creates QR Code symbols, which is a type of two-dimension barcode.
+ * Invented by Denso Wave and described in the ISO/IEC 18004 standard.
+ * A QR Code structure is an immutable square grid of dark and light cells.
+ * The library provides functions to create a QR Code from text or binary data.
+ * The library covers the QR Code Model 2 specification, supporting all versions (sizes)
+ * from 1 to 40, all 4 error correction levels, and 4 character encoding modes.
+ *
+ * Ways to create a QR Code object:
+ * - High level: Take the payload data and call qrcodegen_encodeText() or qrcodegen_encodeBinary().
+ * - Low level: Custom-make the list of segments and call
+ *   qrcodegen_encodeSegments() or qrcodegen_encodeSegmentsAdvanced().
+ * (Note that all ways require supplying the desired error correction level and various byte buffers.)
+ */
+
+
+/*---- Enum and struct types----*/
+
+/*
+ * The error correction level in a QR Code symbol.
+ */
+enum qrcodegen_Ecc {
+	// Must be declared in ascending order of error protection
+	// so that an internal qrcodegen function works properly
+	qrcodegen_Ecc_LOW = 0 ,  // The QR Code can tolerate about  7% erroneous codewords
+	qrcodegen_Ecc_MEDIUM  ,  // The QR Code can tolerate about 15% erroneous codewords
+	qrcodegen_Ecc_QUARTILE,  // The QR Code can tolerate about 25% erroneous codewords
+	qrcodegen_Ecc_HIGH    ,  // The QR Code can tolerate about 30% erroneous codewords
+};
+
+
+/*
+ * The mask pattern used in a QR Code symbol.
+ */
+enum qrcodegen_Mask {
+	// A special value to tell the QR Code encoder to
+	// automatically select an appropriate mask pattern
+	qrcodegen_Mask_AUTO = -1,
+	// The eight actual mask patterns
+	qrcodegen_Mask_0 = 0,
+	qrcodegen_Mask_1,
+	qrcodegen_Mask_2,
+	qrcodegen_Mask_3,
+	qrcodegen_Mask_4,
+	qrcodegen_Mask_5,
+	qrcodegen_Mask_6,
+	qrcodegen_Mask_7,
+};
+
+
+/*
+ * Describes how a segment's data bits are interpreted.
+ */
+enum qrcodegen_Mode {
+	qrcodegen_Mode_NUMERIC      = 0x1,
+	qrcodegen_Mode_ALPHANUMERIC = 0x2,
+	qrcodegen_Mode_BYTE         = 0x4,
+	qrcodegen_Mode_KANJI        = 0x8,
+	qrcodegen_Mode_ECI          = 0x7,
+};
+
+
+/*
+ * A segment of character/binary/control data in a QR Code symbol.
+ * The mid-level way to create a segment is to take the payload data
+ * and call a factory function such as qrcodegen_makeNumeric().
+ * The low-level way to create a segment is to custom-make the bit buffer
+ * and initialize a qrcodegen_Segment struct with appropriate values.
+ * Even in the most favorable conditions, a QR Code can only hold 7089 characters of data.
+ * Any segment longer than this is meaningless for the purpose of generating QR Codes.
+ * Moreover, the maximum allowed bit length is 32767 because
+ * the largest QR Code (version 40) has 31329 modules.
+ */
+struct qrcodegen_Segment {
+	// The mode indicator of this segment.
+	enum qrcodegen_Mode mode;
+
+	// The length of this segment's unencoded data. Measured in characters for
+	// numeric/alphanumeric/kanji mode, bytes for byte mode, and 0 for ECI mode.
+	// Always zero or positive. Not the same as the data's bit length.
+	int numChars;
+
+	// The data bits of this segment, packed in bitwise big endian.
+	// Can be null if the bit length is zero.
+	uint8_t *data;
+
+	// The number of valid data bits used in the buffer. Requires
+	// 0 <= bitLength <= 32767, and bitLength <= (capacity of data array) * 8.
+	// The character count (numChars) must agree with the mode and the bit buffer length.
+	int bitLength;
+};
+
+
+
+/*---- Macro constants and functions ----*/
+
+#define qrcodegen_VERSION_MIN   1  // The minimum version number supported in the QR Code Model 2 standard
+#define qrcodegen_VERSION_MAX  40  // The maximum version number supported in the QR Code Model 2 standard
+
+// Calculates the number of bytes needed to store any QR Code up to and including the given version number,
+// as a compile-time constant. For example, 'uint8_t buffer[qrcodegen_BUFFER_LEN_FOR_VERSION(25)];'
+// can store any single QR Code from version 1 to 25 (inclusive). The result fits in an int (or int16).
+// Requires qrcodegen_VERSION_MIN <= n <= qrcodegen_VERSION_MAX.
+#define qrcodegen_BUFFER_LEN_FOR_VERSION(n)  ((((n) * 4 + 17) * ((n) * 4 + 17) + 7) / 8 + 1)
+
+// The worst-case number of bytes needed to store one QR Code, up to and including
+// version 40. This value equals 3918, which is just under 4 kilobytes.
+// Use this more convenient value to avoid calculating tighter memory bounds for buffers.
+#define qrcodegen_BUFFER_LEN_MAX  qrcodegen_BUFFER_LEN_FOR_VERSION(qrcodegen_VERSION_MAX)
+
+
+
+/*---- Functions (high level) to generate QR Codes ----*/
+
+/*
+ * Encodes the given text string to a QR Code, returning true if successful.
+ * If the data is too long to fit in any version in the given range
+ * at the given ECC level, then false is returned.
+ *
+ * The input text must be encoded in UTF-8 and contain no NULs.
+ * Requires 1 <= minVersion <= maxVersion <= 40.
+ *
+ * The smallest possible QR Code version within the given range is automatically
+ * chosen for the output. Iff boostEcl is true, then the ECC level of the result
+ * may be higher than the ecl argument if it can be done without increasing the
+ * version. The mask is either between qrcodegen_Mask_0 to 7 to force that mask, or
+ * qrcodegen_Mask_AUTO to automatically choose an appropriate mask (which may be slow).
+ *
+ * About the arrays, letting len = qrcodegen_BUFFER_LEN_FOR_VERSION(maxVersion):
+ * - Before calling the function:
+ *   - The array ranges tempBuffer[0 : len] and qrcode[0 : len] must allow
+ *     reading and writing; hence each array must have a length of at least len.
+ *   - The two ranges must not overlap (aliasing).
+ *   - The initial state of both ranges can be uninitialized
+ *     because the function always writes before reading.
+ * - After the function returns:
+ *   - Both ranges have no guarantee on which elements are initialized and what values are stored.
+ *   - tempBuffer contains no useful data and should be treated as entirely uninitialized.
+ *   - If successful, qrcode can be passed into qrcodegen_getSize() and qrcodegen_getModule().
+ *
+ * If successful, the resulting QR Code may use numeric,
+ * alphanumeric, or byte mode to encode the text.
+ *
+ * In the most optimistic case, a QR Code at version 40 with low ECC
+ * can hold any UTF-8 string up to 2953 bytes, or any alphanumeric string
+ * up to 4296 characters, or any digit string up to 7089 characters.
+ * These numbers represent the hard upper limit of the QR Code standard.
+ *
+ * Please consult the QR Code specification for information on
+ * data capacities per version, ECC level, and text encoding mode.
+ */
+bool qrcodegen_encodeText(const char *text, uint8_t tempBuffer[], uint8_t qrcode[],
+	enum qrcodegen_Ecc ecl, int minVersion, int maxVersion, enum qrcodegen_Mask mask, bool boostEcl);
+
+
+/*
+ * Encodes the given binary data to a QR Code, returning true if successful.
+ * If the data is too long to fit in any version in the given range
+ * at the given ECC level, then false is returned.
+ *
+ * Requires 1 <= minVersion <= maxVersion <= 40.
+ *
+ * The smallest possible QR Code version within the given range is automatically
+ * chosen for the output. Iff boostEcl is true, then the ECC level of the result
+ * may be higher than the ecl argument if it can be done without increasing the
+ * version. The mask is either between qrcodegen_Mask_0 to 7 to force that mask, or
+ * qrcodegen_Mask_AUTO to automatically choose an appropriate mask (which may be slow).
+ *
+ * About the arrays, letting len = qrcodegen_BUFFER_LEN_FOR_VERSION(maxVersion):
+ * - Before calling the function:
+ *   - The array ranges dataAndTemp[0 : len] and qrcode[0 : len] must allow
+ *     reading and writing; hence each array must have a length of at least len.
+ *   - The two ranges must not overlap (aliasing).
+ *   - The input array range dataAndTemp[0 : dataLen] should normally be
+ *     valid UTF-8 text, but is not required by the QR Code standard.
+ *   - The initial state of dataAndTemp[dataLen : len] and qrcode[0 : len]
+ *     can be uninitialized because the function always writes before reading.
+ * - After the function returns:
+ *   - Both ranges have no guarantee on which elements are initialized and what values are stored.
+ *   - dataAndTemp contains no useful data and should be treated as entirely uninitialized.
+ *   - If successful, qrcode can be passed into qrcodegen_getSize() and qrcodegen_getModule().
+ *
+ * If successful, the resulting QR Code will use byte mode to encode the data.
+ *
+ * In the most optimistic case, a QR Code at version 40 with low ECC can hold any byte
+ * sequence up to length 2953. This is the hard upper limit of the QR Code standard.
+ *
+ * Please consult the QR Code specification for information on
+ * data capacities per version, ECC level, and text encoding mode.
+ */
+bool qrcodegen_encodeBinary(uint8_t dataAndTemp[], size_t dataLen, uint8_t qrcode[],
+	enum qrcodegen_Ecc ecl, int minVersion, int maxVersion, enum qrcodegen_Mask mask, bool boostEcl);
+
+
+/*---- Functions (low level) to generate QR Codes ----*/
+
+/*
+ * Encodes the given segments to a QR Code, returning true if successful.
+ * If the data is too long to fit in any version at the given ECC level,
+ * then false is returned.
+ *
+ * The smallest possible QR Code version is automatically chosen for
+ * the output. The ECC level of the result may be higher than the
+ * ecl argument if it can be done without increasing the version.
+ *
+ * About the byte arrays, letting len = qrcodegen_BUFFER_LEN_FOR_VERSION(qrcodegen_VERSION_MAX):
+ * - Before calling the function:
+ *   - The array ranges tempBuffer[0 : len] and qrcode[0 : len] must allow
+ *     reading and writing; hence each array must have a length of at least len.
+ *   - The two ranges must not overlap (aliasing).
+ *   - The initial state of both ranges can be uninitialized
+ *     because the function always writes before reading.
+ *   - The input array segs can contain segments whose data buffers overlap with tempBuffer.
+ * - After the function returns:
+ *   - Both ranges have no guarantee on which elements are initialized and what values are stored.
+ *   - tempBuffer contains no useful data and should be treated as entirely uninitialized.
+ *   - Any segment whose data buffer overlaps with tempBuffer[0 : len]
+ *     must be treated as having invalid values in that array.
+ *   - If successful, qrcode can be passed into qrcodegen_getSize() and qrcodegen_getModule().
+ *
+ * Please consult the QR Code specification for information on
+ * data capacities per version, ECC level, and text encoding mode.
+ *
+ * This function allows the user to create a custom sequence of segments that switches
+ * between modes (such as alphanumeric and byte) to encode text in less space.
+ * This is a low-level API; the high-level API is qrcodegen_encodeText() and qrcodegen_encodeBinary().
+ */
+bool qrcodegen_encodeSegments(const struct qrcodegen_Segment segs[], size_t len,
+	enum qrcodegen_Ecc ecl, uint8_t tempBuffer[], uint8_t qrcode[]);
+
+
+/*
+ * Encodes the given segments to a QR Code, returning true if successful.
+ * If the data is too long to fit in any version in the given range
+ * at the given ECC level, then false is returned.
+ *
+ * Requires 1 <= minVersion <= maxVersion <= 40.
+ *
+ * The smallest possible QR Code version within the given range is automatically
+ * chosen for the output. Iff boostEcl is true, then the ECC level of the result
+ * may be higher than the ecl argument if it can be done without increasing the
+ * version. The mask is either between qrcodegen_Mask_0 to 7 to force that mask, or
+ * qrcodegen_Mask_AUTO to automatically choose an appropriate mask (which may be slow).
+ *
+ * About the byte arrays, letting len = qrcodegen_BUFFER_LEN_FOR_VERSION(qrcodegen_VERSION_MAX):
+ * - Before calling the function:
+ *   - The array ranges tempBuffer[0 : len] and qrcode[0 : len] must allow
+ *     reading and writing; hence each array must have a length of at least len.
+ *   - The two ranges must not overlap (aliasing).
+ *   - The initial state of both ranges can be uninitialized
+ *     because the function always writes before reading.
+ *   - The input array segs can contain segments whose data buffers overlap with tempBuffer.
+ * - After the function returns:
+ *   - Both ranges have no guarantee on which elements are initialized and what values are stored.
+ *   - tempBuffer contains no useful data and should be treated as entirely uninitialized.
+ *   - Any segment whose data buffer overlaps with tempBuffer[0 : len]
+ *     must be treated as having invalid values in that array.
+ *   - If successful, qrcode can be passed into qrcodegen_getSize() and qrcodegen_getModule().
+ *
+ * Please consult the QR Code specification for information on
+ * data capacities per version, ECC level, and text encoding mode.
+ *
+ * This function allows the user to create a custom sequence of segments that switches
+ * between modes (such as alphanumeric and byte) to encode text in less space.
+ * This is a low-level API; the high-level API is qrcodegen_encodeText() and qrcodegen_encodeBinary().
+ */
+bool qrcodegen_encodeSegmentsAdvanced(const struct qrcodegen_Segment segs[], size_t len, enum qrcodegen_Ecc ecl,
+	int minVersion, int maxVersion, enum qrcodegen_Mask mask, bool boostEcl, uint8_t tempBuffer[], uint8_t qrcode[]);
+
+
+/*
+ * Tests whether the given string can be encoded as a segment in numeric mode.
+ * A string is encodable iff each character is in the range 0 to 9.
+ */
+bool qrcodegen_isNumeric(const char *text);
+
+
+/*
+ * Tests whether the given string can be encoded as a segment in alphanumeric mode.
+ * A string is encodable iff each character is in the following set: 0 to 9, A to Z
+ * (uppercase only), space, dollar, percent, asterisk, plus, hyphen, period, slash, colon.
+ */
+bool qrcodegen_isAlphanumeric(const char *text);
+
+
+/*
+ * Returns the number of bytes (uint8_t) needed for the data buffer of a segment
+ * containing the given number of characters using the given mode. Notes:
+ * - Returns SIZE_MAX on failure, i.e. numChars > INT16_MAX or the internal
+ *   calculation of the number of needed bits exceeds INT16_MAX (i.e. 32767).
+ * - Otherwise, all valid results are in the range [0, ceil(INT16_MAX / 8)], i.e. at most 4096.
+ * - It is okay for the user to allocate more bytes for the buffer than needed.
+ * - For byte mode, numChars measures the number of bytes, not Unicode code points.
+ * - For ECI mode, numChars must be 0, and the worst-case number of bytes is returned.
+ *   An actual ECI segment can have shorter data. For non-ECI modes, the result is exact.
+ */
+size_t qrcodegen_calcSegmentBufferSize(enum qrcodegen_Mode mode, size_t numChars);
+
+
+/*
+ * Returns a segment representing the given binary data encoded in
+ * byte mode. All input byte arrays are acceptable. Any text string
+ * can be converted to UTF-8 bytes and encoded as a byte mode segment.
+ */
+struct qrcodegen_Segment qrcodegen_makeBytes(const uint8_t data[], size_t len, uint8_t buf[]);
+
+
+/*
+ * Returns a segment representing the given string of decimal digits encoded in numeric mode.
+ */
+struct qrcodegen_Segment qrcodegen_makeNumeric(const char *digits, uint8_t buf[]);
+
+
+/*
+ * Returns a segment representing the given text string encoded in alphanumeric mode.
+ * The characters allowed are: 0 to 9, A to Z (uppercase only), space,
+ * dollar, percent, asterisk, plus, hyphen, period, slash, colon.
+ */
+struct qrcodegen_Segment qrcodegen_makeAlphanumeric(const char *text, uint8_t buf[]);
+
+
+/*
+ * Returns a segment representing an Extended Channel Interpretation
+ * (ECI) designator with the given assignment value.
+ */
+struct qrcodegen_Segment qrcodegen_makeEci(long assignVal, uint8_t buf[]);
+
+
+/*---- Functions to extract raw data from QR Codes ----*/
+
+/*
+ * Returns the side length of the given QR Code, assuming that encoding succeeded.
+ * The result is in the range [21, 177]. Note that the length of the array buffer
+ * is related to the side length - every 'uint8_t qrcode[]' must have length at least
+ * qrcodegen_BUFFER_LEN_FOR_VERSION(version), which equals ceil(size^2 / 8 + 1).
+ */
+int qrcodegen_getSize(const uint8_t qrcode[]);
+
+
+/*
+ * Returns the color of the module (pixel) at the given coordinates, which is false
+ * for light or true for dark. The top left corner has the coordinates (x=0, y=0).
+ * If the given coordinates are out of bounds, then false (light) is returned.
+ */
+bool qrcodegen_getModule(const uint8_t qrcode[], int x, int y);
+
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/firmware/src/wifi_ble_flow.cpp b/firmware/src/wifi_ble_flow.cpp
new file mode 100644
index 0000000..5ebdd55
--- /dev/null
+++ b/firmware/src/wifi_ble_flow.cpp
@@ -0,0 +1,137 @@
+#include "wifi_ble_flow.h"
+
+#include <string.h>
+
+namespace wifi_ble_flow {
+namespace {
+
+const char kPopAlphabet[] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+
+}  // namespace
+
+Session::Session()
+    : state_(State::Stopped), startedAtMs_(0), candidate_(), candidateValid_(false), startConsumed_(false),
+      ownerTriggered_(false), failedCredentialAttempts_(0), windowMs_(kProvisionWindowMs) {
+  clearCandidate();
+}
+
+bool Session::start(uint32_t nowMs, bool profileConfigured, bool usbPowered, bool ownerTriggered, uint32_t windowMs) {
+  if (startConsumed_) return false;
+  clearCandidate();
+  if ((profileConfigured && !ownerTriggered) || (!usbPowered && !ownerTriggered) || windowMs == 0) {
+    state_ = State::Stopped;
+    return false;
+  }
+  // The BLE scheme uses FREE_BLE. Conservatively allow one BLE start attempt per boot;
+  // the application can still use USB Serial after startup or session failure.
+  startConsumed_ = true;
+  ownerTriggered_ = ownerTriggered;
+  failedCredentialAttempts_ = 0;
+  windowMs_ = windowMs;
+  startedAtMs_ = nowMs;
+  state_ = State::Advertising;
+  return true;
+}
+
+bool Session::active() const { return state_ == State::Advertising || state_ == State::CandidateReceived; }
+
+bool Session::credentialsReceived(const wifi_config::Profile& profile) {
+  if (!active() || !wifi_config::validProfile(profile)) return false;
+  clearCandidate();
+  candidate_ = profile;
+  candidateValid_ = true;
+  state_ = State::CandidateReceived;
+  return true;
+}
+
+bool Session::credentialsFailed() {
+  if (!active()) return false;
+  clearCandidate();
+  if (failedCredentialAttempts_ < kMaxCredentialAttempts) ++failedCredentialAttempts_;
+  if (failedCredentialAttempts_ >= kMaxCredentialAttempts) {
+    state_ = State::Stopped;
+    return false;
+  }
+  state_ = State::Advertising;
+  return true;
+}
+
+bool Session::credentialsSucceeded(wifi_config::Profile& profile) {
+  wifi_config::wipeSensitive(profile);
+  if (state_ != State::CandidateReceived || !candidateValid_) return false;
+  profile = candidate_;
+  clearCandidate();
+  state_ = State::Succeeded;
+  return true;
+}
+
+void Session::authenticationRejected() {
+  // A rejected Security 1 handshake produces no Wi-Fi credential event. Keep the
+  // bounded setup window open for the owner to retry with the displayed PoP.
+}
+
+bool Session::expire(uint32_t nowMs, bool usbPowered) {
+  if (!active()) return false;
+  if (!ownerTriggered_ && !usbPowered) {
+    clearCandidate();
+    state_ = State::TimedOut;
+    return true;
+  }
+  if (uint32_t(nowMs - startedAtMs_) < windowMs_) return false;
+  clearCandidate();
+  state_ = State::TimedOut;
+  return true;
+}
+
+void Session::stop() {
+  clearCandidate();
+  state_ = State::Stopped;
+}
+
+State Session::state() const { return state_; }
+
+bool Session::restartRequiresReboot() const { return startConsumed_ && state_ == State::Stopped; }
+
+void Session::clearCandidate() {
+  wifi_config::wipeSensitive(candidate_);
+  candidateValid_ = false;
+}
+
+bool formatPop(const uint8_t entropy[kPopEntropyBytes], char output[kPopLength + 1]) {
+  if (entropy == NULL || output == NULL) return false;
+
+  uint32_t accumulator = 0;
+  uint8_t availableBits = 0;
+  size_t outputLength = 0;
+  for (size_t i = 0; i < kPopEntropyBytes; ++i) {
+    accumulator = (accumulator << 8) | entropy[i];
+    availableBits = static_cast<uint8_t>(availableBits + 8);
+    while (availableBits >= 5) {
+      availableBits = static_cast<uint8_t>(availableBits - 5);
+      output[outputLength++] = kPopAlphabet[(accumulator >> availableBits) & 0x1Fu];
+    }
+  }
+  if (availableBits != 0) {
+    output[outputLength++] = kPopAlphabet[(accumulator << (5 - availableBits)) & 0x1Fu];
+  }
+  output[outputLength] = '\0';
+  return outputLength == kPopLength;
+}
+
+bool splitPopForDisplay(const char* pop, char first[kPopLength / 2 + 1],
+                        char second[kPopLength / 2 + 1]) {
+  if (first == NULL || second == NULL) return false;
+  memset(first, 0, kPopLength / 2 + 1);
+  memset(second, 0, kPopLength / 2 + 1);
+  if (pop == NULL || strlen(pop) != kPopLength) return false;
+  memcpy(first, pop, kPopLength / 2);
+  memcpy(second, pop + kPopLength / 2, kPopLength / 2);
+  return true;
+}
+
+bool resetAfterCredentialsFailure(Session& session, ProvisioningManager& manager) {
+  if (!session.credentialsFailed()) return false;
+  return manager.resetWifiStateAfterFailure();
+}
+
+}  // namespace wifi_ble_flow
diff --git a/firmware/src/wifi_ble_flow.h b/firmware/src/wifi_ble_flow.h
new file mode 100644
index 0000000..cb94fd9
--- /dev/null
+++ b/firmware/src/wifi_ble_flow.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "wifi_config.h"
+
+namespace wifi_ble_flow {
+
+constexpr uint32_t kProvisionWindowMs = 120000;
+constexpr uint8_t kMaxCredentialAttempts = 3;
+constexpr size_t kPopEntropyBytes = 16;
+constexpr size_t kPopLength = 26;
+
+enum class State : uint8_t { Stopped, Advertising, CandidateReceived, Succeeded, TimedOut };
+
+class ProvisioningManager {
+ public:
+  virtual ~ProvisioningManager() {}
+  virtual bool resetWifiStateAfterFailure() = 0;
+};
+
+class Session {
+ public:
+  Session();
+
+  bool start(uint32_t nowMs, bool profileConfigured, bool usbPowered,
+             bool ownerTriggered = false, uint32_t windowMs = kProvisionWindowMs);
+  bool active() const;
+  bool credentialsReceived(const wifi_config::Profile& profile);
+  bool credentialsFailed();
+  bool credentialsSucceeded(wifi_config::Profile& profile);
+  void authenticationRejected();
+  bool expire(uint32_t nowMs, bool usbPowered);
+  void stop();
+  State state() const;
+  bool restartRequiresReboot() const;
+
+ private:
+  void clearCandidate();
+
+  State state_;
+  uint32_t startedAtMs_;
+  wifi_config::Profile candidate_;
+  bool candidateValid_;
+  bool startConsumed_;
+  bool ownerTriggered_;
+  uint8_t failedCredentialAttempts_;
+  uint32_t windowMs_;
+};
+
+bool formatPop(const uint8_t entropy[kPopEntropyBytes], char output[kPopLength + 1]);
+bool splitPopForDisplay(const char* pop, char first[kPopLength / 2 + 1],
+                        char second[kPopLength / 2 + 1]);
+bool resetAfterCredentialsFailure(Session& session, ProvisioningManager& manager);
+
+}  // namespace wifi_ble_flow
diff --git a/firmware/src/wifi_ble_provisioning.cpp b/firmware/src/wifi_ble_provisioning.cpp
new file mode 100644
index 0000000..23e004f
--- /dev/null
+++ b/firmware/src/wifi_ble_provisioning.cpp
@@ -0,0 +1,480 @@
+#include "wifi_ble_provisioning.h"
+
+#include <WiFi.h>
+#include <WiFiProv.h>  // Compile against the exact pinned Arduino provisioning API.
+#include <esp_random.h>
+#include <esp_wifi.h>
+#include <network_provisioning/manager.h>
+#include <network_provisioning/scheme_ble.h>
+#include <sdkconfig.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "freertos/FreeRTOS.h"
+#include "wifi_ble_flow.h"
+#include "wifi_provisioning_commit_gate.h"
+#include "wifi_provisioning_event_queue.h"
+#include "wifi_provisioning_lifecycle.h"
+#include "wifi_setup_intent.h"
+
+#if !defined(CONFIG_NIMBLE_ENABLED) || !CONFIG_NIMBLE_ENABLED
+#error "The pinned StickS3 framework must enable NimBLE for BLE provisioning."
+#endif
+
+#if !defined(CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1) || !CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1
+#error "The pinned provisioning component must enable Security 1."
+#endif
+
+#if !defined(CONFIG_NETWORK_PROV_AUTOSTOP_TIMEOUT) || CONFIG_NETWORK_PROV_AUTOSTOP_TIMEOUT <= 0
+#error "The pinned provisioning component must expose a positive auto-stop timeout."
+#endif
+
+#define AMUSANT_STRINGIFY_INNER(value) #value
+#define AMUSANT_STRINGIFY(value) AMUSANT_STRINGIFY_INNER(value)
+
+namespace wifi_ble_provisioning {
+namespace {
+
+constexpr uint32_t kSdkAutoStopTimeoutMs = static_cast<uint32_t>(CONFIG_NETWORK_PROV_AUTOSTOP_TIMEOUT) * 1000UL;
+
+using ProviderEvent = wifi_provisioning_lifecycle::ProviderEvent;
+
+wifi_ble_flow::Session session;
+char proofOfPossessionValue[wifi_ble_flow::kPopLength + 1] = {};
+char serviceName[16] = {};
+uint8_t customServiceUuid[16] = {
+    0xb4, 0xdf, 0x5a, 0x1c, 0x3f, 0x6b, 0xf4, 0xbf,
+    0xea, 0x4a, 0x82, 0x03, 0x04, 0x90, 0x1a, 0x02};
+wifi_provisioning_event_queue::Queue providerEvents;
+portMUX_TYPE queueMux = portMUX_INITIALIZER_UNLOCKED;
+wifi_provisioning_lifecycle::ManagerLifecycle managerLifecycle;
+bool cancelRequested = false;
+wifi_provisioning_commit_gate::Gate credentialCommitGate;
+
+class NativeProvisioningManager : public wifi_ble_flow::ProvisioningManager {
+ public:
+  bool resetWifiStateAfterFailure() override {
+    return network_prov_mgr_reset_wifi_sm_state_on_failure() == ESP_OK;
+  }
+};
+
+NativeProvisioningManager nativeProvisioningManager;
+
+#if defined(AMUSANT_WIFI_BLE_DIAGNOSTICS) && AMUSANT_WIFI_BLE_DIAGNOSTICS
+const char* providerEventName(ProviderEvent event) {
+  switch (event) {
+    case ProviderEvent::CredentialsReceived: return "CRED_RECV";
+    case ProviderEvent::CredentialsFailed: return "CRED_FAIL";
+    case ProviderEvent::CredentialsSucceeded: return "CRED_SUCCESS";
+    case ProviderEvent::ServiceEnded: return "END";
+    case ProviderEvent::Deinitialized: return "DEINIT";
+  }
+  return "UNKNOWN";
+}
+
+const char* managerStateName(wifi_provisioning_lifecycle::ManagerLifecycle::State state) {
+  using State = wifi_provisioning_lifecycle::ManagerLifecycle::State;
+  switch (state) {
+    case State::Inactive: return "inactive";
+    case State::Running: return "running";
+    case State::StopRequested: return "stop_requested";
+    case State::ServiceEnded: return "service_ended";
+    case State::ExplicitDeinitRequested: return "deinit_requested";
+  }
+  return "unknown";
+}
+
+const char* sessionStateName(wifi_ble_flow::State state) {
+  switch (state) {
+    case wifi_ble_flow::State::Stopped: return "stopped";
+    case wifi_ble_flow::State::Advertising: return "advertising";
+    case wifi_ble_flow::State::CandidateReceived: return "candidate";
+    case wifi_ble_flow::State::Succeeded: return "succeeded";
+    case wifi_ble_flow::State::TimedOut: return "timed_out";
+  }
+  return "unknown";
+}
+
+void snapshotProviderEvents(wifi_provisioning_event_queue::Snapshot& snapshot) {
+  portENTER_CRITICAL(&queueMux);
+  providerEvents.snapshot(snapshot);
+  portEXIT_CRITICAL(&queueMux);
+}
+
+void reportProviderEventCounters() {
+  static wifi_provisioning_event_queue::Snapshot previous = {};
+  wifi_provisioning_event_queue::Snapshot current = {};
+  snapshotProviderEvents(current);
+  for (size_t i = 0; i < wifi_provisioning_event_queue::kProviderEventCount; ++i) {
+    const ProviderEvent event = static_cast<ProviderEvent>(i);
+    if (current.callbacks[i] != previous.callbacks[i]) {
+      Serial.printf("WIFI BLE EVT callback=%s count=%lu at_ms=%lu queue=%u drop=%lu\n",
+                    providerEventName(event), static_cast<unsigned long>(current.callbacks[i]),
+                    static_cast<unsigned long>(current.lastCallbackAtMs[i]), current.credentialDepth,
+                    static_cast<unsigned long>(current.dropped[i]));
+      if (event == ProviderEvent::CredentialsSucceeded) {
+        Serial.printf("WIFI BLE SDK AUTOSTOP CRED_SUCCESS_callback_observed_ms=%lu configured_timeout_ms=%lu timer_start=unobserved\n",
+                      static_cast<unsigned long>(current.lastCallbackAtMs[i]),
+                      static_cast<unsigned long>(kSdkAutoStopTimeoutMs));
+      }
+    }
+    if (current.dequeued[i] != previous.dequeued[i]) {
+      Serial.printf("WIFI BLE EVT dequeue=%s count=%lu callback_at_ms=%lu at_ms=%lu queue=%u\n",
+                    providerEventName(event), static_cast<unsigned long>(current.dequeued[i]),
+                    static_cast<unsigned long>(current.lastDequeuedCallbackAtMs[i]),
+                    static_cast<unsigned long>(current.lastDequeuedAtMs[i]), current.credentialDepth);
+    }
+    if (current.dropped[i] != previous.dropped[i]) {
+      Serial.printf("WIFI BLE EVT dropped=%s count=%lu overflow_total=%lu\n",
+                    providerEventName(event), static_cast<unsigned long>(current.dropped[i]),
+                    static_cast<unsigned long>(current.overflowCount));
+    }
+  }
+  if (current.overflowCount != previous.overflowCount) {
+    Serial.printf("WIFI BLE EVT queue_overflow total=%lu depth=%u terminal_pending=%u/%u\n",
+                  static_cast<unsigned long>(current.overflowCount), current.credentialDepth,
+                  current.serviceEndedPending ? 1U : 0U, current.deinitializedPending ? 1U : 0U);
+  }
+  const size_t successIndex = wifi_provisioning_event_queue::Queue::eventIndex(ProviderEvent::CredentialsSucceeded);
+  const size_t endIndex = wifi_provisioning_event_queue::Queue::eventIndex(ProviderEvent::ServiceEnded);
+  static uint32_t missingEndReportedAfterSuccessMs = UINT32_MAX;
+  const uint32_t successObservedAtMs = current.lastCallbackAtMs[successIndex];
+  if (current.callbacks[endIndex] > 0 && current.callbacks[endIndex] != previous.callbacks[endIndex] &&
+      current.callbacks[successIndex] > 0) {
+    Serial.printf("WIFI BLE SDK AUTOSTOP END_callback_after_CRED_SUCCESS_observed_ms=%lu configured_timeout_ms=%lu timer_start=unobserved\n",
+                  static_cast<unsigned long>(current.lastCallbackAtMs[endIndex] - successObservedAtMs),
+                  static_cast<unsigned long>(kSdkAutoStopTimeoutMs));
+  }
+  if (current.callbacks[successIndex] > 0 && current.callbacks[endIndex] == 0 &&
+      static_cast<uint32_t>(millis() - successObservedAtMs) >= kSdkAutoStopTimeoutMs &&
+      missingEndReportedAfterSuccessMs != successObservedAtMs) {
+    Serial.printf("WIFI BLE SDK AUTOSTOP missing_END after_CRED_SUCCESS_callback_ms=%lu elapsed_since_callback_ms=%lu configured_timeout_ms=%lu timer_start=unobserved\n",
+                  static_cast<unsigned long>(successObservedAtMs),
+                  static_cast<unsigned long>(static_cast<uint32_t>(millis() - successObservedAtMs)),
+                  static_cast<unsigned long>(kSdkAutoStopTimeoutMs));
+    missingEndReportedAfterSuccessMs = successObservedAtMs;
+  }
+  previous = current;
+}
+
+void reportLifecycleState(const char* phase, bool force) {
+  static bool initialized = false;
+  static wifi_provisioning_lifecycle::ManagerLifecycle::State previousManager =
+      wifi_provisioning_lifecycle::ManagerLifecycle::State::Inactive;
+  static wifi_ble_flow::State previousSession = wifi_ble_flow::State::Stopped;
+  static bool previousCancel = false;
+  static bool previousCommitPending = false;
+  const wifi_provisioning_lifecycle::ManagerLifecycle::State managerState = managerLifecycle.state();
+  const wifi_ble_flow::State sessionState = session.state();
+  const bool commitPending = credentialCommitGate.pending();
+  const bool changed = !initialized || managerState != previousManager || sessionState != previousSession ||
+                       cancelRequested != previousCancel || commitPending != previousCommitPending;
+  if (force || changed) {
+    const bool managerActive = managerLifecycle.active();
+    const bool sessionActive = session.active();
+    Serial.printf("WIFI BLE STATE phase=%s at_ms=%lu manager=%s manager_active=%u session=%s session_active=%u active=%u gate=%u cancel=%u autostop_ms=%lu fallback_ms=%lu\n",
+                  phase, static_cast<unsigned long>(millis()), managerStateName(managerState), managerActive ? 1U : 0U,
+                  sessionStateName(sessionState), sessionActive ? 1U : 0U,
+                  managerActive || sessionActive ? 1U : 0U, commitPending ? 1U : 0U,
+                  cancelRequested ? 1U : 0U, static_cast<unsigned long>(kSdkAutoStopTimeoutMs),
+                  static_cast<unsigned long>(wifi_setup_intent::managerDrainTimeoutMs(kSdkAutoStopTimeoutMs)));
+  }
+  initialized = true;
+  previousManager = managerState;
+  previousSession = sessionState;
+  previousCancel = cancelRequested;
+  previousCommitPending = commitPending;
+}
+#endif
+
+void wipeBytes(void* data, size_t length) {
+  volatile uint8_t* bytes = static_cast<volatile uint8_t*>(data);
+  while (length--) *bytes++ = 0;
+}
+
+bool makeProfile(const wifi_sta_config_t& config, wifi_config::Profile& profile) {
+  wifi_config::wipeSensitive(profile);
+  size_t ssidLength = 0;
+  while (ssidLength < sizeof(config.ssid) && config.ssid[ssidLength] != 0) ++ssidLength;
+  size_t passwordLength = 0;
+  while (passwordLength < sizeof(config.password) && config.password[passwordLength] != 0) ++passwordLength;
+
+  if (ssidLength == 0 || ssidLength > 32 || passwordLength < 8 || passwordLength > 63) return false;
+  memcpy(profile.ssid, config.ssid, ssidLength);
+  memcpy(profile.password, config.password, passwordLength);
+  profile.ssid[ssidLength] = '\0';
+  profile.password[passwordLength] = '\0';
+  profile.ssidLength = static_cast<uint8_t>(ssidLength);
+  profile.passwordLength = static_cast<uint8_t>(passwordLength);
+  if (wifi_config::validProfile(profile)) return true;
+  wifi_config::wipeSensitive(profile);
+  return false;
+}
+
+void enqueue(ProviderEvent type, const wifi_config::Profile* profile, uint32_t callbackAtMs) {
+  portENTER_CRITICAL(&queueMux);
+  providerEvents.enqueue(type, profile, callbackAtMs);
+  portEXIT_CRITICAL(&queueMux);
+}
+
+wifi_provisioning_event_queue::ServiceStep serviceQueueStep(
+    wifi_provisioning_event_queue::Event& event, uint32_t nowMs, bool terminalOnly = false) {
+  portENTER_CRITICAL(&queueMux);
+  const wifi_provisioning_event_queue::ServiceStep step =
+      wifi_provisioning_event_queue::serviceStep(providerEvents, event, managerLifecycle, nowMs, terminalOnly);
+  portEXIT_CRITICAL(&queueMux);
+  return step;
+}
+
+void clearQueue() {
+  portENTER_CRITICAL(&queueMux);
+  providerEvents.reset();
+  portEXIT_CRITICAL(&queueMux);
+}
+
+void clearCredentialQueue() {
+  portENTER_CRITICAL(&queueMux);
+  providerEvents.clearCredentialEvents();
+  portEXIT_CRITICAL(&queueMux);
+}
+
+bool hasTerminalEventPending() {
+  portENTER_CRITICAL(&queueMux);
+  const bool pending = providerEvents.hasTerminalPending();
+  portEXIT_CRITICAL(&queueMux);
+  return pending;
+}
+
+void onProvisioningEvent(void*, network_prov_cb_event_t event, void* eventData) {
+  if (event == NETWORK_PROV_WIFI_CRED_RECV && eventData != NULL) {
+    wifi_config::Profile profile = {};
+    const bool valid = makeProfile(*static_cast<const wifi_sta_config_t*>(eventData), profile);
+    enqueue(valid ? ProviderEvent::CredentialsReceived : ProviderEvent::CredentialsFailed,
+            valid ? &profile : NULL, millis());
+    wifi_config::wipeSensitive(profile);
+  } else if (event == NETWORK_PROV_WIFI_CRED_FAIL) {
+    enqueue(ProviderEvent::CredentialsFailed, NULL, millis());
+  } else if (event == NETWORK_PROV_WIFI_CRED_SUCCESS) {
+    enqueue(ProviderEvent::CredentialsSucceeded, NULL, millis());
+  } else if (event == NETWORK_PROV_END) {
+    enqueue(ProviderEvent::ServiceEnded, NULL, millis());
+  } else if (event == NETWORK_PROV_DEINIT) {
+    enqueue(ProviderEvent::Deinitialized, NULL, millis());
+  }
+}
+
+void requestStop() {
+  if (managerLifecycle.requestStop()) {
+    network_prov_mgr_stop_provisioning();
+  }
+}
+
+bool buildProof() {
+  uint8_t entropy[wifi_ble_flow::kPopEntropyBytes] = {};
+  esp_fill_random(entropy, sizeof(entropy));  // Called after the Wi-Fi RF subsystem is started.
+  const bool ok = wifi_ble_flow::formatPop(entropy, proofOfPossessionValue);
+  wipeBytes(entropy, sizeof(entropy));
+  return ok;
+}
+
+}  // namespace
+
+bool start(bool profileConfigured, bool usbPowered, uint32_t nowMs, bool ownerTriggered) {
+  const uint32_t windowMs = ownerTriggered ? wifi_setup_intent::kPhysicalSetupWindowMs
+                                            : wifi_ble_flow::kProvisionWindowMs;
+  if (managerLifecycle.active() || !session.start(nowMs, profileConfigured, usbPowered, ownerTriggered, windowMs)) return false;
+  clearQueue();
+  wipeBytes(proofOfPossessionValue, sizeof(proofOfPossessionValue));
+  wipeBytes(serviceName, sizeof(serviceName));
+  credentialCommitGate.reset();
+
+  WiFi.persistent(false);
+  if (!WiFi.STA.begin(false) || esp_wifi_set_storage(WIFI_STORAGE_RAM) != ESP_OK) {
+    session.stop();
+    return false;
+  }
+
+  // Never let an old esp_wifi NVS profile be considered by provisioning. Wi-Fi
+  // remains RAM-only; amu_wifi/profile is the sole persistent source of credentials.
+  wifi_config_t emptyConfig = {};
+  esp_wifi_disconnect();
+  if (esp_wifi_set_config(WIFI_IF_STA, &emptyConfig) != ESP_OK || !buildProof()) {
+    session.stop();
+    return false;
+  }
+
+  uint8_t mac[6] = {};
+  if (esp_wifi_get_mac(WIFI_IF_STA, mac) != ESP_OK) {
+    session.stop();
+    wipeBytes(proofOfPossessionValue, sizeof(proofOfPossessionValue));
+    return false;
+  }
+  snprintf(serviceName, sizeof(serviceName), "PROV_%02X%02X%02X", mac[3], mac[4], mac[5]);
+
+  network_prov_mgr_config_t config = {};
+  config.scheme = network_prov_scheme_ble;
+  network_prov_event_handler_t schemeHandler = NETWORK_PROV_SCHEME_BLE_EVENT_HANDLER_FREE_BLE;
+  memcpy(&config.scheme_event_handler, &schemeHandler, sizeof(schemeHandler));
+  config.app_event_handler.event_cb = onProvisioningEvent;
+  config.app_event_handler.user_data = NULL;
+#if defined(AMUSANT_WIFI_BLE_DIAGNOSTICS) && AMUSANT_WIFI_BLE_DIAGNOSTICS
+  Serial.printf("WIFI BLE AUTOSTOP configured_timeout_s=" AMUSANT_STRINGIFY(CONFIG_NETWORK_PROV_AUTOSTOP_TIMEOUT) " fallback_timeout_ms=%lu\n",
+                static_cast<unsigned long>(wifi_setup_intent::managerDrainTimeoutMs(kSdkAutoStopTimeoutMs)));
+#endif
+  if (network_prov_mgr_init(config) != ESP_OK) {
+    session.stop();
+    wipeBytes(proofOfPossessionValue, sizeof(proofOfPossessionValue));
+    return false;
+  }
+
+  managerLifecycle.onInitialized();
+  cancelRequested = false;
+#if defined(AMUSANT_WIFI_BLE_DIAGNOSTICS) && AMUSANT_WIFI_BLE_DIAGNOSTICS
+  reportLifecycleState("initialized", true);
+#endif
+  const bool uuidSet = network_prov_scheme_ble_set_service_uuid(customServiceUuid) == ESP_OK;
+  const bool provisioningStarted =
+      uuidSet && network_prov_mgr_start_provisioning(NETWORK_PROV_SECURITY_1, proofOfPossessionValue, serviceName, NULL) == ESP_OK;
+  if (!provisioningStarted) {
+    if (managerLifecycle.requestDeinitialize()) network_prov_mgr_deinit();
+    managerLifecycle.onDeinitialized();
+    session.stop();
+    wipeBytes(proofOfPossessionValue, sizeof(proofOfPossessionValue));
+    clearQueue();
+    return false;
+  }
+  return true;
+}
+
+void stop() {
+  credentialCommitGate.cancel();
+  if (managerLifecycle.active()) {
+    cancelRequested = true;
+    session.stop();
+    requestStop();
+  }
+  if (!managerLifecycle.active()) {
+    session.stop();
+    wipeBytes(proofOfPossessionValue, sizeof(proofOfPossessionValue));
+  }
+}
+
+void service(uint32_t nowMs, bool usbPowered, Event& event, wifi_config::Profile& profile) {
+  event = Event::None;
+  wifi_config::wipeSensitive(profile);
+#if defined(AMUSANT_WIFI_BLE_DIAGNOSTICS) && AMUSANT_WIFI_BLE_DIAGNOSTICS
+  reportProviderEventCounters();
+  reportLifecycleState("service", false);
+#endif
+
+  if (session.expire(nowMs, usbPowered)) {
+    credentialCommitGate.cancel();
+    requestStop();
+    event = Event::TimedOut;
+    return;
+  }
+
+  if (credentialCommitGate.pending()) {
+    const IPAddress address = WiFi.localIP();
+    const bool hasIpAddress = address[0] != 0 || address[1] != 0 || address[2] != 0 || address[3] != 0;
+    const wifi_provisioning_commit_gate::PollResult result = credentialCommitGate.poll(
+        nowMs, WiFi.status() == WL_CONNECTED, hasIpAddress);
+    if (result == wifi_provisioning_commit_gate::PollResult::Commit) {
+      wipeBytes(proofOfPossessionValue, sizeof(proofOfPossessionValue));
+      if (session.credentialsSucceeded(profile)) {
+        event = Event::CredentialsSucceeded;
+      } else {
+        credentialCommitGate.cancel();
+        requestStop();
+        event = Event::Error;
+      }
+      return;
+    }
+    if (result == wifi_provisioning_commit_gate::PollResult::TimedOut) {
+      session.stop();
+      wipeBytes(proofOfPossessionValue, sizeof(proofOfPossessionValue));
+      requestStop();
+      event = Event::Error;
+      return;
+    }
+  }
+  const bool managerActive = managerLifecycle.active();
+  if (!managerActive && !hasTerminalEventPending()) return;
+  wifi_provisioning_event_queue::Event queued = {};
+  const wifi_provisioning_event_queue::ServiceStep queueStep =
+      serviceQueueStep(queued, nowMs, !managerActive);
+  if (queueStep.result == wifi_provisioning_event_queue::ServiceResult::Overflow) {
+    session.credentialsFailed();
+    if (queueStep.requestStop) network_prov_mgr_stop_provisioning();
+    event = Event::CredentialsFailed;
+    return;
+  }
+  if (queueStep.result == wifi_provisioning_event_queue::ServiceResult::Empty) return;
+
+  if (cancelRequested && wifi_provisioning_lifecycle::discardOnCancel(queued.type)) {
+    wifi_config::wipeSensitive(queued.profile);
+    return;
+  }
+
+  switch (queued.type) {
+    case ProviderEvent::CredentialsReceived:
+      if (!session.credentialsReceived(queued.profile)) event = Event::CredentialsFailed;
+      break;
+    case ProviderEvent::CredentialsFailed:
+      if (wifi_ble_flow::resetAfterCredentialsFailure(session, nativeProvisioningManager)) {
+        event = Event::CredentialsFailed;
+      } else {
+        requestStop();
+        event = Event::Error;
+      }
+      break;
+    case ProviderEvent::CredentialsSucceeded:
+      if (session.state() == wifi_ble_flow::State::CandidateReceived &&
+          credentialCommitGate.acceptCredentialsSucceeded(nowMs)) {
+      } else {
+        session.credentialsFailed();
+        event = Event::Error;
+      }
+      break;
+    case ProviderEvent::ServiceEnded:
+      break;  // serviceQueueStep updates the lifecycle; Arduino owns manager deinit.
+    case ProviderEvent::Deinitialized:
+      cancelRequested = false;
+      if (!credentialCommitGate.onProviderDeinitialized()) {
+        session.stop();
+        wipeBytes(proofOfPossessionValue, sizeof(proofOfPossessionValue));
+        clearCredentialQueue();
+        event = Event::SessionEnded;
+      }
+      break;
+  }
+  wifi_config::wipeSensitive(queued.profile);
+}
+
+bool active() { return managerLifecycle.active() || session.active(); }
+
+bool restartRequiresReboot() { return session.restartRequiresReboot(); }
+
+const char* provisioningServiceName() {
+  using State = wifi_provisioning_lifecycle::ManagerLifecycle::State;
+  if (managerLifecycle.state() != State::Running || !session.active()) return "";
+  return serviceName;
+}
+
+uint32_t sdkAutoStopTimeoutMs() { return kSdkAutoStopTimeoutMs; }
+
+void logDiagnostics(const char* phase) {
+#if defined(AMUSANT_WIFI_BLE_DIAGNOSTICS) && AMUSANT_WIFI_BLE_DIAGNOSTICS
+  reportProviderEventCounters();
+  reportLifecycleState(phase != NULL ? phase : "snapshot", true);
+#else
+  (void)phase;
+#endif
+}
+
+const char* proofOfPossession() { return proofOfPossessionValue; }
+
+}  // namespace wifi_ble_provisioning
+
+#undef AMUSANT_STRINGIFY
+#undef AMUSANT_STRINGIFY_INNER
