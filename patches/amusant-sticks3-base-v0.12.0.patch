diff --git a/firmware/src/wifi_ble_qr.cpp b/firmware/src/wifi_ble_qr.cpp
new file mode 100644
index 0000000..3b52312
--- /dev/null
+++ b/firmware/src/wifi_ble_qr.cpp
@@ -0,0 +1,110 @@
+#include "wifi_ble_qr.h"
+
+#include <stdio.h>
+#include <string.h>
+
+#include "third_party/nayuki/qrcodegen.h"
+
+namespace wifi_ble_qr {
+namespace {
+
+constexpr size_t kQrBufferLength = qrcodegen_BUFFER_LEN_FOR_VERSION(kQrVersion);
+static_assert(kQrBufferLength == 173, "Unexpected Nayuki QR buffer size for version 5");
+
+uint8_t qrBuffer[kQrBufferLength] = {};
+uint8_t tempBuffer[kQrBufferLength] = {};
+bool qrReady = false;
+
+void wipe(void* data, size_t size) {
+  volatile uint8_t* bytes = static_cast<volatile uint8_t*>(data);
+  for (size_t i = 0; i < size; ++i) bytes[i] = 0;
+}
+
+bool isServiceNameValid(const char* serviceName) {
+  if (serviceName == NULL || strlen(serviceName) != 11 || strncmp(serviceName, "PROV_", 5) != 0) return false;
+  for (size_t i = 5; i < 11; ++i) {
+    const char c = serviceName[i];
+    if (!((c >= '0' && c <= '9') || (c >= 'A' && c <= 'F'))) return false;
+  }
+  return true;
+}
+
+bool isProofValid(const char* proofOfPossession) {
+  static const char alphabet[] = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
+  if (proofOfPossession == NULL || strlen(proofOfPossession) != 26) return false;
+  for (size_t i = 0; i < 26; ++i) {
+    if (strchr(alphabet, proofOfPossession[i]) == NULL) return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+bool buildPayload(const char* serviceName, const char* proofOfPossession,
+                  char* output, size_t outputCapacity) {
+  if (output == NULL || outputCapacity == 0) return false;
+  output[0] = '\0';
+  if (!isServiceNameValid(serviceName) || !isProofValid(proofOfPossession)) return false;
+
+  const int length = snprintf(output, outputCapacity,
+      "{\"ver\":\"v1\",\"name\":\"%s\",\"pop\":\"%s\",\"transport\":\"ble\",\"security\":1}",
+      serviceName, proofOfPossession);
+  if (length <= 0 || static_cast<size_t>(length) >= outputCapacity) {
+    output[0] = '\0';
+    return false;
+  }
+  for (int i = 0; i < length; ++i) {
+    const unsigned char c = static_cast<unsigned char>(output[i]);
+    if (c < 0x21 || c > 0x7E) {
+      output[0] = '\0';
+      return false;
+    }
+  }
+  return true;
+}
+
+bool begin(const char* serviceName, const char* proofOfPossession) {
+  if (qrReady) return false;
+  clear();
+
+  char payload[kPayloadCapacity] = {};
+  if (!buildPayload(serviceName, proofOfPossession, payload, sizeof(payload))) {
+    wipe(payload, sizeof(payload));
+    return false;
+  }
+
+  const bool encoded = qrcodegen_encodeText(payload, tempBuffer, qrBuffer,
+      qrcodegen_Ecc_LOW, kQrVersion, kQrVersion, qrcodegen_Mask_AUTO, false);
+  wipe(payload, sizeof(payload));
+  wipe(tempBuffer, sizeof(tempBuffer));
+  if (!encoded || qrcodegen_getSize(qrBuffer) != kModuleCount) {
+    clear();
+    return false;
+  }
+  qrReady = true;
+  return true;
+}
+
+void clear() {
+  wipe(qrBuffer, sizeof(qrBuffer));
+  wipe(tempBuffer, sizeof(tempBuffer));
+  qrReady = false;
+}
+
+bool active() { return qrReady; }
+
+int size() { return qrReady ? qrcodegen_getSize(qrBuffer) : 0; }
+
+bool darkModule(int x, int y) {
+  if (!qrReady || x < 0 || y < 0 || x >= kModuleCount || y >= kModuleCount) return false;
+  return qrcodegen_getModule(qrBuffer, x, y);
+}
+
+bool darkPixel(int x, int y) {
+  if (!qrReady || x < 0 || y < 0 || x >= kQrPixelSize || y >= kQrPixelSize) return false;
+  const int moduleX = x / kPixelsPerModule - kQuietZoneModules;
+  const int moduleY = y / kPixelsPerModule - kQuietZoneModules;
+  return darkModule(moduleX, moduleY);
+}
+
+}  // namespace wifi_ble_qr
diff --git a/firmware/src/wifi_ble_qr.h b/firmware/src/wifi_ble_qr.h
new file mode 100644
index 0000000..dfbc72f
--- /dev/null
+++ b/firmware/src/wifi_ble_qr.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace wifi_ble_qr {
+
+constexpr int kQrVersion = 5;
+constexpr int kModuleCount = 4 * kQrVersion + 17;
+constexpr int kQuietZoneModules = 4;
+constexpr int kPixelsPerModule = 3;
+constexpr int kQrPixelSize = (kModuleCount + 2 * kQuietZoneModules) * kPixelsPerModule;
+constexpr int kCanvasWidth = 240;
+constexpr int kCanvasHeight = 135;
+constexpr int kQrLeft = (kCanvasWidth - kQrPixelSize) / 2;
+constexpr int kQrTop = (kCanvasHeight - kQrPixelSize) / 2;
+constexpr int kQrBottom = kQrTop + kQrPixelSize;
+constexpr size_t kPayloadCapacity = 128;
+
+static_assert(kModuleCount == 37, "The fixed QR version changed");
+static_assert(kQrPixelSize == 135, "The fixed QR version and module scale changed");
+static_assert(kQrLeft >= 0 && kQrLeft + kQrPixelSize <= kCanvasWidth, "QR exceeds canvas width");
+static_assert(kQrTop == 0 && kQrBottom == kCanvasHeight, "QR must use the full canvas height");
+
+// Owns only page-selection state. A short front click toggles pages while a
+// valid session QR is available; clearing the session makes both pages inert.
+class PageState {
+ public:
+  PageState() : active_(false), qrAvailable_(false), qrPage_(false) {}
+
+  void show(bool qrAvailable, bool defaultToQr) {
+    active_ = true;
+    qrAvailable_ = qrAvailable;
+    qrPage_ = qrAvailable && defaultToQr;
+  }
+
+  bool toggle() {
+    if (!active_ || !qrAvailable_) return false;
+    qrPage_ = !qrPage_;
+    return true;
+  }
+
+  void clear() {
+    active_ = false;
+    qrAvailable_ = false;
+    qrPage_ = false;
+  }
+
+  bool active() const { return active_; }
+  bool qrAvailable() const { return qrAvailable_; }
+  bool qrPage() const { return active_ && qrAvailable_ && qrPage_; }
+
+ private:
+  bool active_;
+  bool qrAvailable_;
+  bool qrPage_;
+};
+
+bool buildPayload(const char* serviceName, const char* proofOfPossession,
+                  char* output, size_t outputCapacity);
+bool begin(const char* serviceName, const char* proofOfPossession);
+void clear();
+bool active();
+int size();
+bool darkModule(int x, int y);
+bool darkPixel(int x, int y);
+
+}  // namespace wifi_ble_qr
diff --git a/firmware/src/wifi_config.cpp b/firmware/src/wifi_config.cpp
new file mode 100644
index 0000000..afc941e
--- /dev/null
+++ b/firmware/src/wifi_config.cpp
@@ -0,0 +1,156 @@
+#include "wifi_config.h"
+
+#include <Preferences.h>
+#include <string.h>
+
+namespace wifi_config {
+namespace {
+
+constexpr char kNamespace[] = "amu_wifi";
+constexpr char kKey[] = "profile";
+constexpr size_t kSsidOffset = 7;
+constexpr size_t kPasswordOffset = kSsidOffset + 32;
+constexpr size_t kChecksumOffset = kPasswordOffset + 63;
+constexpr size_t kRecordSize = kChecksumOffset + 4;
+constexpr uint8_t kVersion = 1;
+constexpr uint8_t kMagic[] = {'A', 'W', 'F', '1'};
+
+uint32_t crc32(const uint8_t* data, size_t length) {
+  uint32_t crc = 0xFFFFFFFFu;
+  for (size_t i = 0; i < length; ++i) {
+    crc ^= data[i];
+    for (uint8_t bit = 0; bit < 8; ++bit)
+      crc = (crc & 1u) ? ((crc >> 1) ^ 0xEDB88320u) : (crc >> 1);
+  }
+  return crc ^ 0xFFFFFFFFu;
+}
+
+void wipe(void* value, size_t length) {
+  volatile uint8_t* bytes = static_cast<volatile uint8_t*>(value);
+  while (length--) *bytes++ = 0;
+}
+
+uint32_t readU32(const uint8_t* data) {
+  return uint32_t(data[0]) | (uint32_t(data[1]) << 8) | (uint32_t(data[2]) << 16) |
+         (uint32_t(data[3]) << 24);
+}
+
+void writeU32(uint8_t* data, uint32_t value) {
+  data[0] = uint8_t(value);
+  data[1] = uint8_t(value >> 8);
+  data[2] = uint8_t(value >> 16);
+  data[3] = uint8_t(value >> 24);
+}
+
+bool allZero(const uint8_t* data, size_t length) {
+  for (size_t i = 0; i < length; ++i)
+    if (data[i] != 0) return false;
+  return true;
+}
+
+}  // namespace
+
+void wipeSensitive(Profile& profile) { wipe(&profile, sizeof(profile)); }
+
+bool validProfile(const Profile& profile) {
+  if (profile.ssidLength == 0 || profile.ssidLength > 32 ||
+      profile.passwordLength < 8 || profile.passwordLength > 63)
+    return false;
+  if (profile.ssid[profile.ssidLength] != '\0' ||
+      profile.password[profile.passwordLength] != '\0')
+    return false;
+
+  for (size_t i = 0; i < profile.ssidLength; ++i) {
+    const uint8_t c = static_cast<uint8_t>(profile.ssid[i]);
+    if (c < 0x20 || c == 0x7F) return false;
+  }
+  for (size_t i = 0; i < profile.passwordLength; ++i) {
+    const uint8_t c = static_cast<uint8_t>(profile.password[i]);
+    if (c < 0x20 || c > 0x7E) return false;
+  }
+  return true;
+}
+
+LoadResult load(Profile& profile) {
+  wipe(&profile, sizeof(profile));
+
+  Preferences preferences;
+  if (!preferences.begin(kNamespace, true)) {
+    // Preferences.begin(..., false) opens this namespace as NVS_READWRITE. The
+    // load path below issues no putBytes/nvs_set or nvs_commit for the profile
+    // key, but an NVS implementation may update namespace metadata while opening.
+    // Continue through ordinary key validation so a readable profile is not
+    // misclassified if the read-only open failed for another recoverable reason.
+    if (!preferences.begin(kNamespace, false)) return LoadResult::Invalid;
+  }
+  const size_t storedLength = preferences.getBytesLength(kKey);
+  if (storedLength == 0) {
+    preferences.end();
+    return LoadResult::Missing;
+  }
+
+  uint8_t record[kRecordSize] = {};
+  const bool readOk = storedLength == sizeof(record) &&
+                      preferences.getBytes(kKey, record, sizeof(record)) == sizeof(record);
+  preferences.end();
+  if (!readOk) {
+    wipe(record, sizeof(record));
+    return LoadResult::Invalid;
+  }
+
+  bool valid = memcmp(record, kMagic, sizeof(kMagic)) == 0 && record[4] == kVersion;
+  const uint8_t ssidLength = record[5];
+  const uint8_t passwordLength = record[6];
+  valid = valid && ssidLength > 0 && ssidLength <= 32 &&
+          passwordLength >= 8 && passwordLength <= 63;
+  valid = valid && crc32(record, kChecksumOffset) == readU32(record + kChecksumOffset);
+  if (valid) {
+    valid = allZero(record + kSsidOffset + ssidLength, 32 - ssidLength) &&
+            allZero(record + kPasswordOffset + passwordLength, 63 - passwordLength);
+  }
+
+  if (valid) {
+    memcpy(profile.ssid, record + kSsidOffset, ssidLength);
+    memcpy(profile.password, record + kPasswordOffset, passwordLength);
+    profile.ssid[ssidLength] = '\0';
+    profile.password[passwordLength] = '\0';
+    profile.ssidLength = ssidLength;
+    profile.passwordLength = passwordLength;
+    valid = validProfile(profile);
+  }
+
+  wipe(record, sizeof(record));
+  if (!valid) wipe(&profile, sizeof(profile));
+  return valid ? LoadResult::Valid : LoadResult::Invalid;
+}
+
+bool save(const Profile& profile) {
+  if (!validProfile(profile)) return false;
+
+  uint8_t record[kRecordSize] = {};
+  memcpy(record, kMagic, sizeof(kMagic));
+  record[4] = kVersion;
+  record[5] = profile.ssidLength;
+  record[6] = profile.passwordLength;
+  memcpy(record + kSsidOffset, profile.ssid, profile.ssidLength);
+  memcpy(record + kPasswordOffset, profile.password, profile.passwordLength);
+  writeU32(record + kChecksumOffset, crc32(record, kChecksumOffset));
+
+  Preferences preferences;
+  const bool opened = preferences.begin(kNamespace, false);
+  const bool written = opened && preferences.putBytes(kKey, record, sizeof(record)) == sizeof(record);
+  if (opened) preferences.end();
+  wipe(record, sizeof(record));
+  return written;
+}
+
+bool clear() {
+  Preferences preferences;
+  if (!preferences.begin(kNamespace, false)) return false;
+  const bool exists = preferences.getBytesLength(kKey) != 0;
+  const bool removed = !exists || preferences.remove(kKey);
+  preferences.end();
+  return removed;
+}
+
+}  // namespace wifi_config
