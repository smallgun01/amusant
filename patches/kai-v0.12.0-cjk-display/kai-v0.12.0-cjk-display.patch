diff --git a/firmware/src/jellii_text_utf8.h b/firmware/src/jellii_text_utf8.h
new file mode 100644
--- /dev/null
+++ b/firmware/src/jellii_text_utf8.h
@@ -0,0 +1,107 @@
+// Jellii display text layout: byte-bounded UTF-8, no heap allocation, no Arduino dependency.
+// Input is valid UTF-8 (decoded JSON captions/cards); invalid bytes advance one byte.
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace jellii_text {
+
+inline size_t next(const char* bytes, size_t length, size_t offset) {
+  if (offset >= length) return length;
+  const uint8_t first = static_cast<uint8_t>(bytes[offset]);
+  size_t count = 1;
+  if (first >= 0xC2 && first <= 0xDF) count = 2;
+  else if (first >= 0xE0 && first <= 0xEF) count = 3;
+  else if (first >= 0xF0 && first <= 0xF4) count = 4;
+  if (offset + count > length) return offset + 1;
+  for (size_t i = offset + 1; i < offset + count; ++i) {
+    if ((static_cast<uint8_t>(bytes[i]) & 0xC0) != 0x80) return offset + 1;
+  }
+  // Reject non-shortest encodings, UTF-16 surrogates, and code points > U+10FFFF.
+  const uint8_t second = count > 1 ? static_cast<uint8_t>(bytes[offset + 1]) : 0;
+  if ((first == 0xE0 && second < 0xA0) || (first == 0xED && second >= 0xA0) ||
+      (first == 0xF0 && second < 0x90) || (first == 0xF4 && second > 0x8F))
+    return offset + 1;
+  return offset + count;
+}
+
+inline size_t prefix(const char* bytes, size_t length, size_t max_bytes) {
+  size_t pos = 0;
+  while (pos < length) {
+    const size_t n = next(bytes, length, pos);
+    if (n > max_bytes) break;
+    pos = n;
+  }
+  return pos;
+}
+
+inline bool space(char c) { return c == ' ' || c == '\t'; }
+
+template <typename Measure, typename Emit>
+void wrap(const char* bytes, size_t length, int max_width, Measure measure, Emit emit) {
+  if (!bytes || !length || max_width <= 0) return;
+  constexpr size_t npos = static_cast<size_t>(-1);
+  size_t start = 0;
+  size_t pos = 0;
+  size_t space_break = npos;
+  const auto emit_trimmed = [&](size_t begin, size_t end) {
+    while (end > begin && space(bytes[end - 1])) --end;
+    if (end > begin) emit(begin, end);
+  };
+  while (pos < length) {
+    const char c = bytes[pos];
+    const size_t advance = next(bytes, length, pos);
+    if (c == '\n' || c == '\r') {
+      size_t end = pos;
+      while (end > start && space(bytes[end - 1])) --end;
+      if (end > start) emit(start, end);
+      else if (c == '\n') emit(start, start);  // Preserve an intentional empty line.
+      pos = advance;
+      if (c == '\r' && pos < length && bytes[pos] == '\n') ++pos;
+      start = pos;
+      space_break = npos;
+      continue;
+    }
+    if (space(c) && pos == start) {
+      start = pos = advance;  // Never draw leading spaces on wrapped lines.
+      continue;
+    }
+    if (measure(start, advance) <= max_width) {
+      if (space(c)) space_break = pos;
+      pos = advance;
+      continue;
+    }
+    if (space_break != npos && space_break > start) {
+      emit_trimmed(start, space_break);  // Prefer word boundary for English.
+      start = space_break;
+      while (start < length && space(bytes[start])) ++start;
+      pos = start;
+    } else if (pos > start) {
+      emit_trimmed(start, pos);  // CJK and long unspaced words break at UTF-8 boundaries.
+      start = pos;
+    } else {
+      emit(start, advance);  // Guard against a single glyph wider than the viewport.
+      start = pos = advance;
+    }
+    space_break = npos;
+  }
+  size_t end = length;
+  while (end > start && space(bytes[end - 1])) --end;
+  if (end > start) emit(start, end);
+}
+
+template <typename Measure>
+size_t fitting_prefix(const char* bytes, size_t length, int max_width, Measure measure) {
+  if (!bytes || max_width <= 0) return 0;
+  size_t pos = 0;
+  while (pos < length) {
+    const size_t end = next(bytes, length, pos);
+    if (measure(0, end) > max_width) break;
+    pos = end;
+  }
+  return pos;
+}
+
+}  // namespace jellii_text
+
