+  uint32_t dropped[kProviderEventCount];
+  uint32_t lastCallbackAtMs[kProviderEventCount];
+  uint32_t lastDequeuedAtMs[kProviderEventCount];
+  uint32_t lastDequeuedCallbackAtMs[kProviderEventCount];
+  uint32_t overflowCount;
+  uint8_t credentialDepth;
+  bool serviceEndedPending;
+  bool deinitializedPending;
+};
+
+enum class ServiceResult : uint8_t { Empty, Overflow, Event };
+
+struct ServiceStep {
+  ServiceResult result;
+  bool requestStop;
+};
