index 0000000..757219c
--- /dev/null
+++ b/firmware/src/wifi_setup_intent.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace wifi_setup_intent {
+
+constexpr uint32_t kBootIntentMagic = 0x57494649UL;
+constexpr uint32_t kPhysicalGestureHoldMs = 5000;
+constexpr uint32_t kPhysicalSetupWindowMs = 180000;
+constexpr uint32_t kManagerDrainTimeoutMs = 30000;
+constexpr uint8_t kMinimumEntryBatteryPercent = 20;
+constexpr uint8_t kAbortBatteryPercent = 15;
+
+inline bool consume(uint32_t& storedIntent, bool softwareRestart) {
+  const bool requested = softwareRestart && storedIntent == kBootIntentMagic;
+  storedIntent = 0;
+  return requested;
+}
+
+inline bool batteryAllowsEntry(int batteryPercent, bool usbPowered) {
+  return usbPowered || (batteryPercent >= kMinimumEntryBatteryPercent && batteryPercent <= 100);
+}
+
+inline bool abortForBattery(int batteryPercent, bool usbPowered) {
+  return !usbPowered && (batteryPercent < kAbortBatteryPercent || batteryPercent > 100);
+}
+
+inline bool setupGestureEligible(bool idle, bool offline, bool earlyTalk, bool listening,
+                                 bool voicePlaybackIdle) {
+  return (idle || offline) && !earlyTalk && !listening && voicePlaybackIdle;
+}
+
+inline bool networkReady(bool provisionerAccepted, bool wifiConnected, bool hasIpAddress) {
+  return provisionerAccepted && wifiConnected && hasIpAddress;
+}
+
+}  // namespace wifi_setup_intent
diff --git a/firmware/src/wifi_provisioning_commit_gate.h b/firmware/src/wifi_provisioning_commit_gate.h
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/firmware/src/wifi_provisioning_commit_gate.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace wifi_provisioning_commit_gate {
+
+constexpr uint32_t kAssociationTimeoutMs = 15000;
+
+enum class PollResult : uint8_t {
+  None,
+  Waiting,
+  Commit,
+  TimedOut,
+};
+
+class Gate {
+ public:
+  Gate() : pending_(false), providerEnded_(false), startedAtMs_(0) {}
+
+  void reset() {
+    pending_ = false;
+    providerEnded_ = false;
+    startedAtMs_ = 0;
+  }
+
+  bool acceptCredentialsSucceeded(uint32_t nowMs) {
+    if (pending_) return false;
+    pending_ = true;
+    providerEnded_ = false;
+    startedAtMs_ = nowMs;
+    return true;
+  }
+
+  bool onProviderDeinitialized() {
+    providerEnded_ = true;
+    return pending_;
+  }
+
+  PollResult poll(uint32_t nowMs, bool wifiConnected, bool hasIpAddress) {
+    if (!pending_) return PollResult::None;
+    if (wifiConnected && hasIpAddress) {
+      pending_ = false;
+      return PollResult::Commit;
+    }
+    if (uint32_t(nowMs - startedAtMs_) >= kAssociationTimeoutMs) {
+      pending_ = false;
+      return PollResult::TimedOut;
+    }
+    return PollResult::Waiting;
+  }
+
+  void cancel() {
+    pending_ = false;
+    startedAtMs_ = 0;
+  }
+
+  bool pending() const { return pending_; }
+  bool providerEnded() const { return providerEnded_; }
+
+ private:
+  bool pending_;
+  bool providerEnded_;
+  uint32_t startedAtMs_;
+};
+
+}  // namespace wifi_provisioning_commit_gate
