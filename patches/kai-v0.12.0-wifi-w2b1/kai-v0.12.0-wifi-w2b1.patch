+ public:
+  Queue() { reset(); }
+
+  void reset() {
+    clearPending();
+    for (size_t i = 0; i < kProviderEventCount; ++i) {
+      callbacks_[i] = 0;
+      dequeued_[i] = 0;
+      dropped_[i] = 0;
+      lastCallbackAtMs_[i] = 0;
+      lastDequeuedAtMs_[i] = 0;
+      lastDequeuedCallbackAtMs_[i] = 0;
+    }
+    overflowCount_ = 0;
+    overflowHandled_ = 0;
+    nextSequence_ = 1;
+  }
