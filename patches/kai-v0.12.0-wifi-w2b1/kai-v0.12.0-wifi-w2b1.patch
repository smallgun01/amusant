+  bool dequeue(Event& event, uint32_t dequeuedAtMs, bool terminalOnly = false) {
+    const bool credentialAvailable = !terminalOnly && credentialCount_ > 0;
+    const bool takeServiceEnd = serviceEndedPending_ &&
+        (!deinitializedPending_ || serviceEndedSequence_ < deinitializedSequence_);
+    const bool terminalAvailable = serviceEndedPending_ || deinitializedPending_;
+    const uint32_t terminalSequence = takeServiceEnd ? serviceEndedSequence_ : deinitializedSequence_;
