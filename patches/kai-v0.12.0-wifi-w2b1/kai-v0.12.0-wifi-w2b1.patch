+               const wifi_config::Profile* profile, uint32_t callbackAtMs) {
+    const size_t index = eventIndex(type);
+    ++callbacks_[index];
+    lastCallbackAtMs_[index] = callbackAtMs;
+
+    if (type == wifi_provisioning_lifecycle::ProviderEvent::ServiceEnded) {
+      if (!serviceEndedPending_) {
+        serviceEndedSequence_ = nextSequence_++;
+        serviceEndedAtMs_ = callbackAtMs;
+      }
+      serviceEndedPending_ = true;
+      return true;
+    }
+    if (type == wifi_provisioning_lifecycle::ProviderEvent::Deinitialized) {
+      if (!deinitializedPending_) {
+        deinitializedSequence_ = nextSequence_++;
+        deinitializedAtMs_ = callbackAtMs;
+      }
+      deinitializedPending_ = true;
+      return true;
+    }
