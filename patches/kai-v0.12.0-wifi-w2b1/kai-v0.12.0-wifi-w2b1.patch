+static void serviceOwnerSetupBoot() {
+  serviceWifiConsole();
+  const uint32_t now = millis();
+  if (!setupReturnToNormal && M5.BtnB.wasClicked()) {
+    requestOwnerSetupExit("Setup cancelled; Wi-Fi kept");
+  }
+  if (!setupReturnToNormal && uint32_t(now - lastSetupBatteryCheck) >= 5000) {
+    lastSetupBatteryCheck = now;
+    if (wifi_setup_intent::abortForBattery(M5.Power.getBatteryLevel(), audio::onUsbPower())) {
+      requestOwnerSetupExit("Battery low; Wi-Fi kept");
+    }
+  }
+
+  serviceWifiBleProvisioning();
+  if (!setupReturnToNormal && !wifi_ble_provisioning::active()) {
+    requestOwnerSetupExit("Setup ended; Wi-Fi kept");
+  }
+  if (setupReturnToNormal && !wifi_ble_provisioning::active()) restartNormalAfterOwnerSetup();
+  if (setupReturnToNormal && uint32_t(now - setupReturnStartedAt) >= wifi_setup_intent::kManagerDrainTimeoutMs) {
+    Serial.println("WIFI BLE DRAIN TIMEOUT");
+    esp_restart();
