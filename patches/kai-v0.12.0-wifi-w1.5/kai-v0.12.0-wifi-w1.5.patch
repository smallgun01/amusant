+#pragma once
+
+#include <stdint.h>
+
+#include "wifi_config.h"
+
+namespace wifi_ble_provisioning {
+
+enum class Event : uint8_t { None, CredentialsFailed, CredentialsSucceeded, TimedOut, SessionEnded, Error };
+
+bool start(bool profileConfigured, bool usbPowered, uint32_t nowMs);
+void stop();
+void service(uint32_t nowMs, bool usbPowered, Event& event, wifi_config::Profile& profile);
+bool active();
+const char* proofOfPossession();
+
+}  // namespace wifi_ble_provisioning
