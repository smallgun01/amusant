diff --git a/firmware/src/jellii_cjk_diagnostic.h b/firmware/src/jellii_cjk_diagnostic.h
new file mode 100644
--- /dev/null
+++ b/firmware/src/jellii_cjk_diagnostic.h
@@ -0,0 +1,121 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace jellii_cjk_diagnostic {
+
+static const uint32_t kReplacementCodepoint = 0xFFFD;
+static const size_t kMaxReportedCaptionScalars = 64;
+
+enum class Classification : uint8_t {
+  Missing,
+  Format,
+  NonBmp,
+  Invalid,
+};
+
+inline const char* classificationName(Classification classification) {
+  switch (classification) {
+    case Classification::Missing: return "MISSING";
+    case Classification::Format: return "FORMAT";
+    case Classification::NonBmp: return "NONBMP";
+    case Classification::Invalid: return "INVALID";
+  }
+  return "INVALID";
+}
+
+inline bool displayCommandBusy(bool bleActive, bool listening, bool thinking,
+                               bool replyMode, bool turnComplete,
+                               bool playbackIdle, bool voicePending,
+                               bool replyCooldownActive) {
+  return bleActive || listening || thinking ||
+         (replyMode && (!turnComplete || !playbackIdle || voicePending)) ||
+         replyCooldownActive;
+}
+
+inline bool decodeNext(const char* bytes, size_t length, size_t offset,
+                       uint32_t& codepoint, size_t& nextOffset) {
+  codepoint = kReplacementCodepoint;
+  nextOffset = offset + 1;
+  if (!bytes || offset >= length) return false;
+
+  const uint8_t first = static_cast<uint8_t>(bytes[offset]);
+  if (first < 0x80) {
+    codepoint = first;
+    return true;
+  }
+
+  size_t count = 0;
+  if (first >= 0xC2 && first <= 0xDF) count = 2;
+  else if (first >= 0xE0 && first <= 0xEF) count = 3;
+  else if (first >= 0xF0 && first <= 0xF4) count = 4;
+  else return false;
+  if (offset + count > length) return false;
+
+  for (size_t i = 1; i < count; ++i) {
+    const uint8_t continuation = static_cast<uint8_t>(bytes[offset + i]);
+    if ((continuation & 0xC0) != 0x80) return false;
+  }
+  const uint8_t second = static_cast<uint8_t>(bytes[offset + 1]);
+  if ((first == 0xE0 && second < 0xA0) ||
+      (first == 0xED && second >= 0xA0) ||
+      (first == 0xF0 && second < 0x90) ||
+      (first == 0xF4 && second > 0x8F)) return false;
+
+  uint32_t value = count == 2 ? first & 0x1F :
+                   count == 3 ? first & 0x0F : first & 0x07;
+  for (size_t i = 1; i < count; ++i) {
+    value = (value << 6) | (static_cast<uint8_t>(bytes[offset + i]) & 0x3F);
+  }
+  codepoint = value;
+  nextOffset = offset + count;
+  return true;
+}
+
+template <typename HasGlyph, typename Report>
+size_t reportUnsupported(const char* bytes, size_t length, HasGlyph hasGlyph,
+                         Report report, uint32_t* seen, size_t& seenCount) {
+  if (!bytes || !seen) return 0;
+  size_t emitted = 0;
+  for (size_t offset = 0; offset < length;) {
+    uint32_t codepoint = kReplacementCodepoint;
+    size_t nextOffset = offset + 1;
+    const bool valid = decodeNext(bytes, length, offset, codepoint, nextOffset);
+    Classification classification = Classification::Invalid;
+    bool unsupported = false;
+    if (!valid || codepoint == kReplacementCodepoint) {
+      classification = Classification::Invalid;
+      unsupported = true;
+    } else if (codepoint > 0xFFFF) {
+      classification = Classification::NonBmp;
+      unsupported = true;
+    } else if (codepoint == 0xFE0F || codepoint == 0x200D) {
+      classification = Classification::Format;
+      unsupported = true;
+    } else if (codepoint >= 0x20 && !hasGlyph(codepoint)) {
+      classification = Classification::Missing;
+      unsupported = true;
+    }
+
+    if (unsupported) {
+      bool duplicate = false;
+      for (size_t i = 0; i < seenCount; ++i) {
+        if (seen[i] == codepoint) {
+          duplicate = true;
+          break;
+        }
+      }
+      if (!duplicate) {
+        if (seenCount >= kMaxReportedCaptionScalars) break;
+        seen[seenCount++] = codepoint;
+        report(classification, codepoint);
+        ++emitted;
+      }
+    }
+    offset = nextOffset > offset ? nextOffset : offset + 1;
+  }
+  return emitted;
+}
+
+}  // namespace jellii_cjk_diagnostic
