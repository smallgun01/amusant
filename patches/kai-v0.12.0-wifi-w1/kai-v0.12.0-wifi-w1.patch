diff --git a/firmware/src/wifi_config.cpp b/firmware/src/wifi_config.cpp
new file mode 100644
index 0000000..170e685
--- /dev/null
+++ b/firmware/src/wifi_config.cpp
@@ -0,0 +1,147 @@
+#include "wifi_config.h"
+
+#include <Preferences.h>
+#include <string.h>
+
+namespace wifi_config {
+namespace {
+
+constexpr char kNamespace[] = "amu_wifi";
+constexpr char kKey[] = "profile";
+constexpr size_t kSsidOffset = 7;
+constexpr size_t kPasswordOffset = kSsidOffset + 32;
+constexpr size_t kChecksumOffset = kPasswordOffset + 63;
+constexpr size_t kRecordSize = kChecksumOffset + 4;
+constexpr uint8_t kVersion = 1;
+constexpr uint8_t kMagic[] = {'A', 'W', 'F', '1'};
+
+uint32_t crc32(const uint8_t* data, size_t length) {
+  uint32_t crc = 0xFFFFFFFFu;
+  for (size_t i = 0; i < length; ++i) {
+    crc ^= data[i];
+    for (uint8_t bit = 0; bit < 8; ++bit)
+      crc = (crc & 1u) ? ((crc >> 1) ^ 0xEDB88320u) : (crc >> 1);
+  }
+  return crc ^ 0xFFFFFFFFu;
+}
+
+void wipe(void* value, size_t length) {
+  volatile uint8_t* bytes = static_cast<volatile uint8_t*>(value);
+  while (length--) *bytes++ = 0;
+}
+
+uint32_t readU32(const uint8_t* data) {
+  return uint32_t(data[0]) | (uint32_t(data[1]) << 8) | (uint32_t(data[2]) << 16) |
+         (uint32_t(data[3]) << 24);
+}
+
+void writeU32(uint8_t* data, uint32_t value) {
+  data[0] = uint8_t(value);
+  data[1] = uint8_t(value >> 8);
+  data[2] = uint8_t(value >> 16);
+  data[3] = uint8_t(value >> 24);
+}
+
+bool allZero(const uint8_t* data, size_t length) {
+  for (size_t i = 0; i < length; ++i)
+    if (data[i] != 0) return false;
+  return true;
+}
+
+}  // namespace
+
+bool validProfile(const Profile& profile) {
+  if (profile.ssidLength == 0 || profile.ssidLength > 32 ||
+      profile.passwordLength < 8 || profile.passwordLength > 63)
+    return false;
+  if (profile.ssid[profile.ssidLength] != '\0' ||
+      profile.password[profile.passwordLength] != '\0')
+    return false;
+
+  for (size_t i = 0; i < profile.ssidLength; ++i) {
+    const uint8_t c = static_cast<uint8_t>(profile.ssid[i]);
+    if (c < 0x20 || c == 0x7F) return false;
+  }
+  for (size_t i = 0; i < profile.passwordLength; ++i) {
+    const uint8_t c = static_cast<uint8_t>(profile.password[i]);
+    if (c < 0x20 || c > 0x7E) return false;
+  }
+  return true;
+}
+
+LoadResult load(Profile& profile) {
+  wipe(&profile, sizeof(profile));
+
+  Preferences preferences;
+  if (!preferences.begin(kNamespace, true)) return LoadResult::Invalid;
+  const size_t storedLength = preferences.getBytesLength(kKey);
+  if (storedLength == 0) {
+    preferences.end();
+    return LoadResult::Missing;
+  }
+
+  uint8_t record[kRecordSize] = {};
+  const bool readOk = storedLength == sizeof(record) &&
+                      preferences.getBytes(kKey, record, sizeof(record)) == sizeof(record);
+  preferences.end();
+  if (!readOk) {
+    wipe(record, sizeof(record));
+    return LoadResult::Invalid;
+  }
+
+  bool valid = memcmp(record, kMagic, sizeof(kMagic)) == 0 && record[4] == kVersion;
+  const uint8_t ssidLength = record[5];
+  const uint8_t passwordLength = record[6];
+  valid = valid && ssidLength > 0 && ssidLength <= 32 &&
+          passwordLength >= 8 && passwordLength <= 63;
+  valid = valid && crc32(record, kChecksumOffset) == readU32(record + kChecksumOffset);
+  if (valid) {
+    valid = allZero(record + kSsidOffset + ssidLength, 32 - ssidLength) &&
+            allZero(record + kPasswordOffset + passwordLength, 63 - passwordLength);
+  }
+
+  if (valid) {
+    memcpy(profile.ssid, record + kSsidOffset, ssidLength);
+    memcpy(profile.password, record + kPasswordOffset, passwordLength);
+    profile.ssid[ssidLength] = '\0';
+    profile.password[passwordLength] = '\0';
+    profile.ssidLength = ssidLength;
+    profile.passwordLength = passwordLength;
+    valid = validProfile(profile);
+  }
+
+  wipe(record, sizeof(record));
+  if (!valid) wipe(&profile, sizeof(profile));
+  return valid ? LoadResult::Valid : LoadResult::Invalid;
+}
+
+bool save(const Profile& profile) {
+  if (!validProfile(profile)) return false;
+
+  uint8_t record[kRecordSize] = {};
+  memcpy(record, kMagic, sizeof(kMagic));
+  record[4] = kVersion;
+  record[5] = profile.ssidLength;
+  record[6] = profile.passwordLength;
+  memcpy(record + kSsidOffset, profile.ssid, profile.ssidLength);
+  memcpy(record + kPasswordOffset, profile.password, profile.passwordLength);
+  writeU32(record + kChecksumOffset, crc32(record, kChecksumOffset));
+
+  Preferences preferences;
+  const bool opened = preferences.begin(kNamespace, false);
+  const bool written = opened && preferences.putBytes(kKey, record, sizeof(record)) == sizeof(record);
+  if (opened) preferences.end();
+  wipe(record, sizeof(record));
+  return written;
+}
+
+bool clear() {
+  Preferences preferences;
+  if (!preferences.begin(kNamespace, false)) return false;
+  const bool exists = preferences.getBytesLength(kKey) != 0;
+  const bool removed = !exists || preferences.remove(kKey);
+  preferences.end();
+  return removed;
+}
+
+}  // namespace wifi_config
diff --git a/firmware/src/wifi_config.h b/firmware/src/wifi_config.h
new file mode 100644
index 0000000..26313b6
--- /dev/null
+++ b/firmware/src/wifi_config.h
@@ -0,0 +1,25 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace wifi_config {
+
+constexpr size_t kSsidCapacity = 33;
+constexpr size_t kPasswordCapacity = 64;
+
+struct Profile {
+  char ssid[kSsidCapacity];
+  char password[kPasswordCapacity];
+  uint8_t ssidLength;
+  uint8_t passwordLength;
+};
+
+enum class LoadResult : uint8_t { Missing, Valid, Invalid };
+
+bool validProfile(const Profile& profile);
+LoadResult load(Profile& profile);
+bool save(const Profile& profile);
+bool clear();
+
+}  // namespace wifi_config
diff --git a/firmware/src/wifi_console.cpp b/firmware/src/wifi_console.cpp
new file mode 100644
index 0000000..80eb857
--- /dev/null
+++ b/firmware/src/wifi_console.cpp
@@ -0,0 +1,137 @@
+#include "wifi_console.h"
+
+#include <string.h>
+
+namespace wifi_console {
+namespace {
+
+constexpr uint32_t kInputTimeoutMs = 15000;
+
+void wipe(void* value, size_t length) {
+  volatile uint8_t* bytes = static_cast<volatile uint8_t*>(value);
+  while (length--) *bytes++ = 0;
+}
+
+bool parseLength(const char*& cursor, uint8_t maximum, uint8_t& value) {
+  if (*cursor < '0' || *cursor > '9') return false;
+  uint16_t parsed = 0;
+  do {
+    parsed = uint16_t(parsed * 10 + uint8_t(*cursor - '0'));
+    if (parsed > maximum) return false;
+    ++cursor;
+  } while (*cursor >= '0' && *cursor <= '9');
+  value = static_cast<uint8_t>(parsed);
+  return true;
+}
+
+}  // namespace
+
+Parser::Parser() { reset(); }
+
+void Parser::reset() {
+  state_ = State::Line;
+  wipe(line_, sizeof(line_));
+  lineLength_ = 0;
+  discardLine_ = false;
+  wipe(payload_, sizeof(payload_));
+  payloadLength_ = 0;
+  payloadRead_ = 0;
+  expectedSsidLength_ = 0;
+  expectedPasswordLength_ = 0;
+  lastByteAtMs_ = 0;
+}
+
+bool Parser::processLine(uint32_t nowMs, Event& event) {
+  if (strcmp(line_, "WIFI STATUS") == 0) {
+    event.type = EventType::Status;
+    reset();
+    return true;
+  }
+  if (strcmp(line_, "WIFI CLEAR") == 0) {
+    event.type = EventType::Clear;
+    reset();
+    return true;
+  }
+
+  static const char kSetPrefix[] = "WIFI SET ";
+  if (strncmp(line_, kSetPrefix, sizeof(kSetPrefix) - 1) != 0) {
+    event.type = EventType::Error;
+    reset();
+    return true;
+  }
+
+  const char* cursor = line_ + sizeof(kSetPrefix) - 1;
+  uint8_t ssidLength = 0;
+  uint8_t passwordLength = 0;
+  if (!parseLength(cursor, 32, ssidLength) || *cursor++ != ' ' ||
+      !parseLength(cursor, 63, passwordLength) || *cursor != '\0' ||
+      ssidLength == 0 || passwordLength < 8) {
+    event.type = EventType::Error;
+    reset();
+    return true;
+  }
+
+  expectedSsidLength_ = ssidLength;
+  expectedPasswordLength_ = passwordLength;
+  payloadLength_ = uint8_t(ssidLength + passwordLength);
+  payloadRead_ = 0;
+  state_ = State::Payload;
+  lastByteAtMs_ = nowMs;
+  event.type = EventType::SetReady;
+  return true;
+}
+
+bool Parser::feed(uint8_t byte, uint32_t nowMs, Event& event) {
+  event.type = EventType::None;
+  wipe(&event.profile, sizeof(event.profile));
+
+  const bool active = state_ == State::Payload || lineLength_ != 0 || discardLine_;
+  if (active && uint32_t(nowMs - lastByteAtMs_) > kInputTimeoutMs) {
+    reset();
+    event.type = EventType::Timeout;
+    return true;
+  }
+
+  if (state_ == State::Payload) {
+    lastByteAtMs_ = nowMs;
+    payload_[payloadRead_++] = byte;
+    if (payloadRead_ < payloadLength_) return false;
+
+    event.profile.ssidLength = expectedSsidLength_;
+    event.profile.passwordLength = expectedPasswordLength_;
+    memcpy(event.profile.ssid, payload_, expectedSsidLength_);
+    memcpy(event.profile.password, payload_ + expectedSsidLength_, expectedPasswordLength_);
+    event.profile.ssid[expectedSsidLength_] = '\0';
+    event.profile.password[expectedPasswordLength_] = '\0';
+    const bool valid = wifi_config::validProfile(event.profile);
+    reset();
+    event.type = valid ? EventType::Set : EventType::Error;
+    if (!valid) wipe(&event.profile, sizeof(event.profile));
+    return true;
+  }
+
+  lastByteAtMs_ = nowMs;
+  if (byte == '\r') return false;
+  if (byte == '\n') {
+    if (discardLine_) {
+      reset();
+      event.type = EventType::Error;
+      return true;
+    }
+    if (lineLength_ == 0) return false;
+    return processLine(nowMs, event);
+  }
+  if (byte < 0x20 || byte > 0x7E) {
+    discardLine_ = true;
+    return false;
+  }
+  if (lineLength_ >= sizeof(line_) - 1) {
+    discardLine_ = true;
+    return false;
+  }
+  line_[lineLength_++] = static_cast<char>(byte);
+  line_[lineLength_] = '\0';
+  return false;
+}
+
+}  // namespace wifi_console
diff --git a/firmware/src/wifi_console.h b/firmware/src/wifi_console.h
new file mode 100644
index 0000000..da8da2b
--- /dev/null
+++ b/firmware/src/wifi_console.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <stdint.h>
+
+#include "wifi_config.h"
+
+namespace wifi_console {
+
+enum class EventType : uint8_t { None, Status, Clear, SetReady, Set, Error, Timeout };
+
+struct Event {
+  EventType type;
+  wifi_config::Profile profile;
+};
+
+class Parser {
+ public:
+  Parser();
+  bool feed(uint8_t byte, uint32_t nowMs, Event& event);
+
+ private:
+  enum class State : uint8_t { Line, Payload };
+  void reset();
+  bool processLine(uint32_t nowMs, Event& event);
+
+  State state_;
+  char line_[40];
+  uint8_t lineLength_;
+  bool discardLine_;
+  uint8_t payload_[95];
+  uint8_t payloadLength_;
+  uint8_t payloadRead_;
+  uint8_t expectedSsidLength_;
+  uint8_t expectedPasswordLength_;
+  uint32_t lastByteAtMs_;
+};
+
+}  // namespace wifi_console

