# Template only: replace every sample value after the matching Owner gate.
# In particular, choose image digests from the manually approved release run.
RELAY_IMAGE=ghcr.io/smallgun01/amusant-relay@sha256:REPLACE_WITH_RELEASE_DIGEST
EGRESS_PROXY_IMAGE=ghcr.io/smallgun01/amusant-egress-proxy@sha256:REPLACE_WITH_RELEASE_DIGEST

# Candidate ranges are examples, not approved live network allocations.
# Recheck Docker networks and OCI VCN routes after the Owner's read-only inventory.
RELAY_API_CIDR=172.30.72.0/29
RELAY_BIND_IP=172.30.72.2
CALLBACK_API_CIDR=172.30.74.0/29
RELAY_CALLBACK_BIND_IP=172.30.74.2
RELAY_EGRESS_CIDR=172.30.73.0/29
RELAY_EGRESS_IP=172.30.73.2
EGRESS_PROXY_RELAY_BIND_IP=172.30.73.3
RELAY_HOST_PRIVATE_IP=10.0.0.10

AMUSANT_CLIENT_ID=REPLACE_WITH_CONFIRMED_OWNER_ID
AMUSANT_GROK_ROUTINE_URL=https://routine.example.invalid/webhook
AMUSANT_GROK_CALLBACK_URL=https://callback.example.invalid/callback/results
AMUSANT_GROK_CALLBACK_TRUSTED_HOSTS=callback.example.invalid
AMUSANT_GROK_CALLBACK_SERVICE_PORT=443

# Compose mounts ${OCI_DATA_DIR}/relay as the SQLite v10 ledger.
# Keep this separate from the existing /mnt/amusant-data/relay (SQLite v8).
OCI_DATA_DIR=/mnt/amusant-data/grok
RELAY_STOP_GRACE_PERIOD=30s
AMUSANT_RELAY_SHUTDOWN_GRACE_SECONDS=10
RELAY_CPU_LIMIT=0.5
RELAY_MEMORY_LIMIT=512m
# G4-D2d measured OCI cutover: 0.1 CPU healthcheck timed out; 0.5 CPU passed isolated and live deployment.
PROXY_CPU_LIMIT=0.5
PROXY_MEMORY_LIMIT=128m

# These are path references only; create/populate files after explicit Owner GO.
# Never put credential values in this environment file.
GEMINI_API_KEY_FILE=/mnt/amusant-secrets/grok/gemini_api_key
DEVICE_TOKEN_FILE=/mnt/amusant-secrets/grok/device_token
DEVICE_PSKS_FILE=/mnt/amusant-secrets/grok/device_psks
GROK_ROUTINE_TOKEN_FILE=/mnt/amusant-secrets/grok/routine_token
