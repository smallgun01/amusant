# Copy to .env and replace every value for an offline Compose config check.
# Deploy only exact immutable references ending in @sha256:<64 hex>.
RELAY_IMAGE=
FACADE_IMAGE=
HERMES_IMAGE=
EGRESS_PROXY_IMAGE=

# Four non-overlapping internal networks; choose ranges that do not conflict with the VCN.
RELAY_API_CIDR=172.30.62.0/29
RELAY_BIND_IP=172.30.62.2
FACADE_RELAY_BIND_IP=172.30.62.3
HERMES_API_CIDR=172.30.64.0/29
FACADE_HERMES_BIND_IP=172.30.64.2
HERMES_API_BIND_IP=172.30.64.3
RELAY_EGRESS_CIDR=172.30.63.0/29
RELAY_EGRESS_IP=172.30.63.2
EGRESS_PROXY_RELAY_BIND_IP=172.30.63.3
HERMES_EGRESS_CIDR=172.30.65.0/29
HERMES_EGRESS_IP=172.30.65.2
EGRESS_PROXY_HERMES_BIND_IP=172.30.65.3
RELAY_HOST_PRIVATE_IP=10.0.0.10
# Legacy Compose setting retained for compatibility; Compose no longer publishes this port.
# The proposed systemd ingress renderer fixes the listener at TCP/443 independently.
RELAY_PUBLISH_PORT=8443

# External configuration is operator-owned and must be reviewed/merged manually.
HERMES_CONFIG_FILE=/secure/hermes/config.yaml
# Prepare relay, hermes, and results/facade under the mounted OCI block volume; facade state is UID 10003 mode 0700.
OCI_DATA_DIR=/mnt/amusant-data

# Planning caps only; these values do not prove 1 OCPU performance.
RELAY_CPU_LIMIT=0.35
FACADE_CPU_LIMIT=0.10
HERMES_CPU_LIMIT=0.55
PROXY_CPU_LIMIT=0.05
RELAY_MEMORY_LIMIT=1536m
FACADE_MEMORY_LIMIT=256m
HERMES_MEMORY_LIMIT=3584m
PROXY_MEMORY_LIMIT=128m

AMUSANT_HERMES_RUN_DEADLINE_SECONDS=
AMUSANT_HERMES_POLL_CYCLE_SECONDS=
AMUSANT_HERMES_HTTP_TIMEOUT_SECONDS=
AMUSANT_HERMES_POLL_INTERVAL_SECONDS=
AMUSANT_HERMES_STOP_GRACE_SECONDS=
AMUSANT_HERMES_STOP_MAX_ATTEMPTS=
AMUSANT_HERMES_STOP_RETRY_BASE_SECONDS=
AMUSANT_HERMES_STOP_RETRY_MAX_SECONDS=
AMUSANT_RELAY_SHUTDOWN_GRACE_SECONDS=
RELAY_STOP_GRACE_PERIOD=
FACADE_STOP_GRACE_PERIOD=
HERMES_STOP_GRACE_PERIOD=
AMUSANT_CLIENT_ID=
AMUSANT_BACKEND_ID=

# Secret paths only. Keep secret files outside the repository and .env. The writer key is distinct.
GEMINI_API_KEY_FILE=
DEVICE_TOKEN_FILE=
DEVICE_PSKS_FILE=
FACADE_API_KEY_FILE=
FACADE_WRITER_API_KEY_FILE=
HERMES_API_KEY_FILE=
