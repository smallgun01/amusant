# Copy to .env and replace every value for an offline Compose config check.
# The Dockerfile builds images; deploy only exact registry references ending in @sha256:<64 hex>.
RELAY_IMAGE=
HERMES_IMAGE=
EGRESS_PROXY_IMAGE=

# Examples only. Choose non-overlapping subnets that do not conflict with the VCN.
RELAY_API_CIDR=172.30.62.0/29
RELAY_BIND_IP=172.30.62.2
HERMES_API_BIND_IP=172.30.62.3
CONTROLLED_EGRESS_CIDR=172.30.63.0/29
HERMES_EGRESS_IP=172.30.63.2
RELAY_EGRESS_IP=172.30.63.3
EGRESS_PROXY_BIND_IP=172.30.63.4
RELAY_HOST_PRIVATE_IP=10.0.0.10
RELAY_PUBLISH_PORT=8443
RELAY_LISTEN_PORT=8443

# Volume root must be on an attached OCI block volume and pre-created for the service UIDs.
OCI_DATA_DIR=/mnt/amusant-data

# Planning caps only: 0.35 + 0.55 + 0.05 OCPU do not prove real-time audio capacity.
RELAY_CPU_LIMIT=0.35
HERMES_CPU_LIMIT=0.55
PROXY_CPU_LIMIT=0.05
RELAY_MEMORY_LIMIT=1536m
HERMES_MEMORY_LIMIT=3584m
PROXY_MEMORY_LIMIT=128m

# Product timing values require Owner approval; none are defaulted in the application.
AMUSANT_HERMES_RUN_DEADLINE_SECONDS=
AMUSANT_HERMES_POLL_CYCLE_SECONDS=
AMUSANT_HERMES_HTTP_TIMEOUT_SECONDS=
AMUSANT_HERMES_POLL_INTERVAL_SECONDS=
AMUSANT_HERMES_STOP_GRACE_SECONDS=
AMUSANT_HERMES_STOP_MAX_ATTEMPTS=
AMUSANT_HERMES_STOP_RETRY_BASE_SECONDS=
AMUSANT_HERMES_STOP_RETRY_MAX_SECONDS=
RELAY_STOP_GRACE_PERIOD=
HERMES_STOP_GRACE_PERIOD=

AMUSANT_CLIENT_ID=
AMUSANT_BACKEND_ID=

# Secret paths only. Keep secret files outside the repository and .env.
GEMINI_API_KEY_FILE=
DEVICE_TOKEN_FILE=
DEVICE_PSKS_FILE=
HERMES_API_KEY_FILE=
