# Minimal CONNECT-only egress proxy. No shell, third-party Python packages,
# listener for arbitrary HTTP methods, or direct Hermes internet route.
FROM --platform=$TARGETPLATFORM python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --gid 10002 egress \
    && useradd --uid 10002 --gid 10002 --no-create-home --shell /usr/sbin/nologin egress
COPY --chown=root:root deploy/oci-a1/egress_proxy.py /opt/amusant/egress_proxy.py
RUN chmod 0555 /opt/amusant/egress_proxy.py
USER 10002:10002
ENTRYPOINT ["/usr/local/bin/python", "/opt/amusant/egress_proxy.py"]
