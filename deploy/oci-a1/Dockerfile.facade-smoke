FROM --platform=linux/amd64 python:3.13.15-slim-bookworm@sha256:2325bb286ec344af3e5898cc224b5844e2707ac6e26b1632516fd3edc84a5e26

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app

RUN groupadd --gid 20000 amusant-secret-share \
    && groupadd --gid 10003 facade \
    && useradd --uid 10003 --gid 10003 --groups 20000 --no-create-home --shell /usr/sbin/nologin facade \
    && groupadd --gid 10000 hermes \
    && useradd --uid 10000 --gid 10000 --groups 20000 --no-create-home --shell /usr/sbin/nologin hermes

COPY --chown=root:root deploy/oci-a1/facade.py /app/facade.py
COPY --chown=root:root deploy/oci-a1/hermes_plugin /app/hermes_plugin
COPY --chown=root:root deploy/oci-a1/facade_runtime_smoke.py /app/facade_runtime_smoke.py
RUN chmod 0555 /app/facade.py /app/facade_runtime_smoke.py /app/hermes_plugin/__init__.py /app/hermes_plugin/reprojection.py

ENTRYPOINT ["/usr/local/bin/python", "-B", "/app/facade_runtime_smoke.py"]
